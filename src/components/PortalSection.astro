---
interface PortalView {
  id: string;
  label: string;
  eyebrow: string;
  title: string;
  text: string;
  src: string;
  avifSrcset?: string;
  alt: string;
  width: number;
  height: number;
  sizes?: string;
  signal: string;
}

interface EditorialMediaCard {
  label: string;
  title: string;
  text: string;
  src: string;
  avifSrc?: string;
  alt: string;
  width: number;
  height: number;
}

interface Props {
  data: {
    kicker: string;
    title: string;
    text: string;
    benefits: string[];
    cta: {
      label: string;
      href: string;
      track: string;
    };
    clientAccess: {
      label: string;
      href: string;
      track: string;
    };
    editorialKicker: string;
    editorialTitle: string;
    editorialText: string;
    views: PortalView[];
    editorialMedia: EditorialMediaCard[];
  };
}

const { data } = Astro.props;
const firstSignal = data.views[0]?.signal ?? "Priorités visibles";
const secondSignal = data.views[1]?.signal ?? "Flux centralisés";
---

<section
  class="section-shell portal-section reveal"
  aria-labelledby="portal-title"
  data-track-view="homepage_portal_view"
  data-track-label="homepage_portal"
>
  <div class="portal-copy" data-reveal-item>
    <p class="kicker">{data.kicker}</p>
    <h2 id="portal-title">{data.title}</h2>
    <p class="text">{data.text}</p>

    <div class="portal-actions">
      <a class="btn btn-accent" href={data.cta.href} data-track={data.cta.track}>
        {data.cta.label}
        <span aria-hidden="true">→</span>
      </a>
      <a class="client-access" href={data.clientAccess.href} data-track={data.clientAccess.track}>
        {data.clientAccess.label}
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>

  <div class="portal-showcase" data-portal-demo data-reveal-item>
    <div class="showcase-topbar">
      <div class="window-dots" aria-hidden="true"><span></span><span></span><span></span></div>
      <p>portail.sunelys.fr</p>
      <span class="live-status">Aperçu du portail</span>
    </div>

    <div class="showcase-body">

      <div class="screen-area">
        <div class="portal-tabs" role="tablist" aria-label="Découvrir les vues du portail Sunelys">
          {
            data.views.map((view, index) => (
              <button
                type="button"
                id={`portal-tab-${view.id}`}
                class:list={["portal-tab", index === 0 && "is-active"]}
                role="tab"
                aria-selected={index === 0 ? "true" : "false"}
                aria-controls={`portal-panel-${view.id}`}
                tabindex={index === 0 ? 0 : -1}
                data-portal-tab={view.id}
              >
                <span>0{index + 1}</span>
                {view.label}
              </button>
            ))
          }
        </div>

        <div class="portal-views">
          {
            data.views.map((view, index) => (
              <div
                id={`portal-panel-${view.id}`}
                class="portal-view"
                role="tabpanel"
                aria-labelledby={`portal-tab-${view.id}`}
                tabindex="0"
                hidden={index !== 0}
                data-portal-panel={view.id}
              >
                <figure class="portal-visual">
                  <a class:list={["portal-image-link", view.id === data.views[0]?.id && "portal-image-priority"]} href={view.src} target="_blank" rel="noopener" aria-label={`Agrandir : ${view.label}`} data-portal-enlarge data-portal-title={view.label}><picture>
                    {
                      view.avifSrcset && (
                        <source type="image/avif" srcset={view.avifSrcset} sizes={view.sizes} />
                      )
                    }
                    <img
                      src={view.src}
                      alt={view.alt}
                      width={view.width}
                      height={view.height}
                      loading="lazy"
                      decoding="async"
                      fetchpriority="low"
                    />
                  </picture><span class="portal-enlarge-label" aria-hidden="true">Agrandir <span>+</span></span></a>
                  <figcaption class="visual-signal">
                    <span aria-hidden="true"></span>
                    {view.signal}
                  </figcaption>
                </figure>

                <div class="view-caption">
                  <p>{view.eyebrow}</p>
                  <h3>{view.title}</h3>
                  <span>{view.text}</span>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <div class="demo-footer">
      <p>Septembre 2026 · données de démonstration, aucun dossier client</p>
    </div>
  </div>

  {data.editorialMedia.length > 0 && <div class="portal-editorial-strip" data-reveal-item>
    <div class="editorial-intro">
      <p>{data.editorialKicker}</p>
      <h3>{data.editorialTitle}</h3>
      <span>{data.editorialText}</span>
    </div>

    <div class="editorial-grid">
      {
        data.editorialMedia.map((item) => (
          <article class="editorial-card">
            <figure class="editorial-visual">
              <picture>
                {item.avifSrc && <source type="image/avif" srcset={item.avifSrc} />}
                <img
                  src={item.src}
                  alt={item.alt}
                  width={item.width}
                  height={item.height}
                  loading="lazy"
                  decoding="async"
                  fetchpriority="low"
                />
              </picture>
            </figure>

            <div class="editorial-copy">
              <p>{item.label}</p>
              <h4>{item.title}</h4>
              <span>{item.text}</span>
            </div>
          </article>
        ))
      }
    </div>
  </div>}
</section>

<dialog class="portal-lightbox" aria-labelledby="portal-lightbox-title" data-portal-lightbox>
  <div class="portal-lightbox-toolbar">
    <h2 id="portal-lightbox-title">Portail Sunelys</h2>
    <div class="portal-lightbox-controls">
      <button type="button" data-portal-fit>Vue complète</button>
      <button type="button" data-portal-zoom="out" aria-label="Réduire" title="Réduire">−</button>
      <output data-portal-scale aria-live="polite">100 %</output>
      <button type="button" data-portal-zoom="in" aria-label="Agrandir" title="Agrandir">+</button>
      <button type="button" data-portal-close aria-label="Fermer l’aperçu" title="Fermer l’aperçu">×</button>
    </div>
  </div>
  <div class="portal-lightbox-canvas" tabindex="0" role="region" aria-label="Capture du portail" data-portal-canvas>
    <img alt="" width="1280" height="720" data-portal-full-image />
  </div>
  <p class="portal-lightbox-note">Données de démonstration · aucun dossier client.</p>
</dialog>

<script>
  const lightbox = document.querySelector<HTMLDialogElement>("[data-portal-lightbox]");
  const fullImage = lightbox?.querySelector<HTMLImageElement>("[data-portal-full-image]");
  const canvas = lightbox?.querySelector<HTMLElement>("[data-portal-canvas]");
  const scaleOutput = lightbox?.querySelector<HTMLOutputElement>("[data-portal-scale]");
  let trigger: HTMLAnchorElement | null = null;
  let scale = 1;
  let previousOverflow = "";
  const resizeImage = (next: number) => {
    if (!fullImage || !scaleOutput) return;
    scale = Math.min(2, Math.max(.25, next));
    fullImage.style.width = `${fullImage.naturalWidth * scale}px`;
    scaleOutput.value = `${Math.round(scale * 100)} %`;
  };
  document.querySelectorAll<HTMLAnchorElement>("[data-portal-enlarge]").forEach((link) => {
    link.addEventListener("click", async (event) => {
      if (!lightbox || !fullImage || !canvas || typeof lightbox.showModal !== "function") return;
      event.preventDefault();
      trigger = link;
      fullImage.src = link.href;
      fullImage.alt = link.querySelector("img")?.alt || "Portail Sunelys";
      const title = lightbox.querySelector("h2");
      if (title) title.textContent = link.dataset.portalTitle || "Portail Sunelys";
      previousOverflow = document.body.style.overflow;
      document.body.style.overflow = "hidden";
      lightbox.showModal();
      try { await fullImage.decode(); } catch {}
      fullImage.width = fullImage.naturalWidth || 1280;
      fullImage.height = fullImage.naturalHeight || 720;
      resizeImage(window.innerWidth <= 600 ? 1 : Math.min(1, canvas.clientWidth / fullImage.naturalWidth));
      canvas.scrollTo(0, link.classList.contains("portal-image-priority") && window.innerWidth <= 600 ? 450 : 0);
    });
  });
  lightbox?.querySelector("[data-portal-close]")?.addEventListener("click", () => lightbox.close());
  lightbox?.querySelector("[data-portal-fit]")?.addEventListener("click", () => {
    if (!canvas || !fullImage) return;
    resizeImage(canvas.clientWidth / fullImage.naturalWidth);
    canvas.scrollTo(0, 0);
  });
  lightbox?.querySelectorAll<HTMLElement>("[data-portal-zoom]").forEach((button) => {
    button.addEventListener("click", () => resizeImage(scale + (button.dataset.portalZoom === "in" ? .25 : -.25)));
  });
  lightbox?.addEventListener("click", (event) => { if (event.target === lightbox) lightbox.close(); });
  lightbox?.addEventListener("close", () => {
    document.body.style.overflow = previousOverflow;
    trigger?.focus({ preventScroll: true });
  });
  document.querySelectorAll("[data-portal-demo]").forEach((demo) => {
    if (!(demo instanceof HTMLElement)) return;

    const tabs = Array.from(demo.querySelectorAll("[data-portal-tab]")).filter(
      (tab): tab is HTMLButtonElement => tab instanceof HTMLButtonElement,
    );
    const panels = Array.from(demo.querySelectorAll("[data-portal-panel]")).filter(
      (panel): panel is HTMLElement => panel instanceof HTMLElement,
    );

    const activate = (activeTab: HTMLButtonElement, track = true) => {
      const activeId = activeTab.dataset.portalTab;
      if (!activeId) return;

      tabs.forEach((tab) => {
        const isActive = tab === activeTab;
        tab.classList.toggle("is-active", isActive);
        tab.setAttribute("aria-selected", String(isActive));
        tab.tabIndex = isActive ? 0 : -1;
      });

      panels.forEach((panel) => {
        panel.hidden = panel.dataset.portalPanel !== activeId;
      });

      if (track) {
        window.trackEvent?.("portal_demo_view", {
          category: "engagement",
          label: activeId,
          source: "homepage_portal",
        });
      }
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => activate(tab));
      tab.addEventListener("keydown", (event) => {
        if (!["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key)) return;
        event.preventDefault();

        let nextIndex = index;
        if (event.key === "ArrowRight") nextIndex = (index + 1) % tabs.length;
        if (event.key === "ArrowLeft") nextIndex = (index - 1 + tabs.length) % tabs.length;
        if (event.key === "Home") nextIndex = 0;
        if (event.key === "End") nextIndex = tabs.length - 1;

        const nextTab = tabs[nextIndex];
        if (!nextTab) return;
        activate(nextTab);
        nextTab.focus();
      });
    });
  });
</script>

<style>
  .portal-image-link { position:relative; overflow:hidden; }
  .portal-enlarge-label { position:absolute; right:12px; bottom:12px; display:flex; align-items:center; gap:16px; padding:9px 12px; border:1px solid #414849; border-radius:4px; background:#151718; color:#f7f7f5; font-size:14px; line-height:1.4; }
  .portal-enlarge-label > span { font-size:20px; }
  .portal-lightbox { width:min(1440px, calc(100% - 32px)); max-width:none; max-height:calc(100dvh - 32px); padding:0; border:1px solid #687174; border-radius:6px; background:#202324; color:#f7f7f5; }
  .portal-lightbox::backdrop { background:rgb(0 0 0 / 78%); }
  .portal-lightbox-toolbar { display:flex; justify-content:space-between; align-items:center; gap:16px; padding:12px 16px; border-bottom:1px solid #414849; }
  .portal-lightbox-toolbar h2 { margin:0; font-size:20px; }
  .portal-lightbox-controls { display:flex; align-items:center; gap:8px; flex-wrap:wrap; }
  .portal-lightbox-controls button { min-width:44px; min-height:44px; padding:8px 12px; border:1px solid #687174; border-radius:4px; color:#f7f7f5; background:#292d2e; cursor:pointer; font:inherit; }
  .portal-lightbox-controls button[data-portal-zoom],.portal-lightbox-controls button[data-portal-close] { padding:0; font-size:24px; }
  .portal-lightbox-controls output { min-width:54px; text-align:center; font-size:14px; font-variant-numeric:tabular-nums; }
  .portal-lightbox-canvas { max-height:min(72dvh,900px); overflow:auto; background:#fff; overscroll-behavior:contain; }
  .portal-lightbox-canvas img { display:block; max-width:none; height:auto; }
  .portal-lightbox-note { margin:0; padding:10px 16px; color:#bac0c1; font-size:13px; }
  @media(max-width:600px) {
    .portal-lightbox { width:calc(100% - 16px); max-height:calc(100dvh - 16px); }
    .portal-lightbox-toolbar { display:grid; padding:12px; gap:10px; }
    .portal-lightbox-controls { justify-content:space-between; gap:6px; }
    .portal-lightbox-controls button { font-size:14px; padding:8px; }
    .portal-lightbox-canvas { max-height:65dvh; }
    .portal-image-priority picture { display:block; height:250px; overflow:hidden; }
    .portal-image-priority picture img { width:200%; max-width:none; height:auto; transform:translateY(-38%); }
  }
</style>
