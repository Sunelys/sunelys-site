---
interface Testimonial {
  tabLabel: string;
  quote: string;
  author: string;
  note: string;
  service?: string;
  serviceHref?: string;
  outcome?: string;
  logo?: string;
  logoAlt?: string;
  logoWidth?: number;
  logoHeight?: number;
  journey?: {
    label: string;
    text: string;
  }[];
}

interface Props {
  data: {
    kicker: string;
    title: string;
    testimonials: Testimonial[];
  };
  references: {
    logos: { name: string; src: string; width: number; height: number }[];
    metrics: { value: string; label: string }[];
  };
}

const { data, references } = Astro.props;
const getInitials = (name: string) =>
  name
    .split(/\s+/)
    .map((part) => part[0])
    .join("")
    .slice(0, 2)
    .toUpperCase();

---

<section
  id="client-proof"
  class="section-shell proof-section reveal"
  aria-labelledby="proof-title"
  data-track-view="homepage_client_proof_view"
  data-track-label="homepage_client_proof"
>
  <header class="proof-head" data-reveal-item>
    <div>
      <p class="kicker">{data.kicker}</p>
      <h2 id="proof-title">{data.title}</h2>
    </div>

    <div class="proof-logo-row" aria-label="Installateurs accompagnés">
      {references.logos.filter((logo) => logo.src).map((logo) => (
        <div class="logo-slot"><img src={logo.src} alt={logo.name} width={logo.width} height={logo.height} loading="lazy" decoding="async" /></div>
      ))}
    </div>
  </header>


  <div class="case-experience" data-client-proof data-reveal-item>
    <div class="case-tabs" role="tablist" aria-label="Choisir un retour client Sunelys">
      {
        data.testimonials.map((item, index) => (
          <button
            type="button"
            id={`client-proof-tab-${index + 1}`}
            class:list={["case-tab", index === 0 && "is-active"]}
            role="tab"
            aria-selected={index === 0 ? "true" : "false"}
            aria-controls={`client-proof-panel-${index + 1}`}
            tabindex={index === 0 ? 0 : -1}
            data-client-proof-tab={String(index + 1)}
          >
            <span>0{index + 1}</span>
            <strong>{item.tabLabel}</strong>
            <i aria-hidden="true"></i>
          </button>
        ))
      }
    </div>

    <div class="case-panels">
      {
        data.testimonials.map((item, index) => (
          <article
            id={`client-proof-panel-${index + 1}`}
            class="case-panel"
            role="tabpanel"
            aria-labelledby={`client-proof-tab-${index + 1}`}
            tabindex="0"
            hidden={index !== 0}
            data-client-proof-panel={String(index + 1)}
          >
            <div class="case-context">
              <div class="company-mark">
                {
                  item.logo ? (
                    <img
                      src={item.logo}
                      alt={item.logoAlt || ""}
                      width={item.logoWidth}
                      height={item.logoHeight}
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <span aria-hidden="true">{getInitials(item.author)}</span>
                  )
                }
              </div>

              <div class="case-outcome">
                {item.service && <p>{item.service}</p>}
              </div>

              {
                item.journey && (
                  <details class="case-journey-details"><summary>Le déroulé de l’accompagnement</summary>
                    {item.outcome && <p class="case-outcome-detail">{item.outcome}</p>}
                    <ol class="case-journey" aria-label={`Parcours décrit par ${item.tabLabel}`}>
                    {item.journey.map((step, stepIndex) => (
                      <li>
                        <span>0{stepIndex + 1}</span>
                        <div>
                          <p>{step.label}</p>
                          <strong>{step.text}</strong>
                        </div>
                      </li>
                    ))}
                  </ol></details>
                )
              }
            </div>

            <div class="case-voice">
              <div class="quote-mark" aria-hidden="true">“</div>
              <blockquote>{item.quote}</blockquote>

              <footer>
                <div class="author">
                  <span aria-hidden="true">{getInitials(item.author)}</span>
                  <div>
                    <strong>{item.author}</strong>
                    <p>{item.note}</p>
                  </div>
                </div>
                {item.serviceHref && <a class="case-service-link" href={item.serviceHref} data-track="cta_client_proof_service" data-track-label={item.tabLabel}>Voir la prestation concernée <span aria-hidden="true">→</span></a>}
              </footer>
            </div>
          </article>
        ))
      }
    </div>
  </div>

  <dl class="proof-figures" aria-label="Preuves opérationnelles Sunelys">
    {references.metrics.map((metric) => (
      <div><dt>{metric.label}</dt><dd>{metric.value}</dd></div>
    ))}
  </dl>
</section>

<script>
  document.querySelectorAll("[data-client-proof]").forEach((experience) => {
    if (!(experience instanceof HTMLElement)) return;

    const tabs = Array.from(experience.querySelectorAll("[data-client-proof-tab]")).filter(
      (tab): tab is HTMLButtonElement => tab instanceof HTMLButtonElement,
    );
    const panels = Array.from(experience.querySelectorAll("[data-client-proof-panel]")).filter(
      (panel): panel is HTMLElement => panel instanceof HTMLElement,
    );

    const activate = (activeTab: HTMLButtonElement, track = true) => {
      const activeId = activeTab.dataset.clientProofTab;
      if (!activeId) return;

      tabs.forEach((tab) => {
        const isActive = tab === activeTab;
        tab.classList.toggle("is-active", isActive);
        tab.setAttribute("aria-selected", String(isActive));
        tab.tabIndex = isActive ? 0 : -1;
      });

      panels.forEach((panel) => {
        panel.hidden = panel.dataset.clientProofPanel !== activeId;
      });

      if (track) {
        window.trackEvent?.("client_proof_view", {
          category: "engagement",
          label: activeTab.textContent?.trim() || activeId,
          source: "homepage_proof",
        });
      }
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => activate(tab));
      tab.addEventListener("keydown", (event) => {
        if (!["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key)) return;
        event.preventDefault();

        let nextIndex = index;
        if (event.key === "ArrowRight") nextIndex = (index + 1) % tabs.length;
        if (event.key === "ArrowLeft") nextIndex = (index - 1 + tabs.length) % tabs.length;
        if (event.key === "Home") nextIndex = 0;
        if (event.key === "End") nextIndex = tabs.length - 1;

        const nextTab = tabs[nextIndex];
        if (!nextTab) return;
        activate(nextTab);
        nextTab.focus();
      });
    });
  });
</script>
