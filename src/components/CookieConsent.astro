      border-radius: 16px;
    }

    .cookie-eyebrow {
      font-size: 0.54rem;
    }

    .cookie-copy h2 {
      font-size: 0.9rem;
    }

    .cookie-copy > p:not(.cookie-eyebrow) {
      display: -webkit-box;
      overflow: hidden;
