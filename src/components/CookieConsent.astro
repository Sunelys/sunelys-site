    }

    .cookie-button {
      min-height: 2.16rem;
      padding: 0.42rem 0.46rem;
      font-size: 0.66rem;
    }

    .cookie-actions > a {
      justify-self: start;
      font-size: 0.58rem;
      text-align: left;
    }

    .cookie-label-long {
      display: none;
    }

    .cookie-label-short {
      display: inline;
    }
  }

  @media (max-width: 430px) {
    .cookie-actions > div {
