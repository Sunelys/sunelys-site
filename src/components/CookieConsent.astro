  }

  @media (max-width: 760px) {
    .cookie-consent {
      bottom: max(0.6rem, env(safe-area-inset-bottom, 0px));
      grid-template-columns: 1fr;
      gap: 0.52rem;
      width: min(calc(100% - 0.75rem), 34rem);
      max-height: none;
      overflow: visible;
