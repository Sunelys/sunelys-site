    gap: 1rem;
    align-items: center;
    width: min(calc(100% - 2rem), 52rem);
    padding: 0.92rem 1rem;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: var(--radius-md);
    background:
      radial-gradient(circle at 100% 0%, rgba(54, 98, 227, 0.32), transparent 42%),
      var(--ink);
    box-shadow: 0 20px 54px rgba(14, 23, 38, 0.28);
    color: #ffffff;
    transform: translateX(-50%);
  }

  .cookie-consent[hidden] {
    display: none;
  }

  .cookie-copy {
    display: grid;
    gap: 0.22rem;
  }

  .cookie-eyebrow {
    margin: 0;
    color: var(--accent);
    font-size: 0.64rem;
    font-weight: 820;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .cookie-copy h2 {
    margin: 0;
    color: #ffffff;
    font-size: clamp(1rem, 1.3vw, 1.18rem);
    letter-spacing: 0;
    line-height: 1.05;
  }

  .cookie-copy > p:not(.cookie-eyebrow) {
    max-width: 64ch;
    margin: 0;
    color: #b9c5d5;
    font-size: 0.69rem;
    line-height: 1.34;
  }

  .cookie-current-choice {
    color: #ffffff !important;
    font-weight: 750;
  }

  .cookie-actions {
    display: grid;
    gap: 0.38rem;
    min-width: 0;
  }

  .cookie-actions > div {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
  }

  .cookie-button {
    min-height: 2.3rem;
    border: 1px solid rgba(255, 255, 255, 0.32);
    border-radius: var(--radius-sm);
    cursor: pointer;
    font: inherit;
    font-size: 0.72rem;
    font-weight: 800;
    padding: 0.58rem 0.72rem;
  }

  .cookie-label-short {
    display: none;
  }

  .cookie-button-refuse {
    background: #ffffff;
    color: var(--ink);
  }

  .cookie-button-accept {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--ink);
  }

  .cookie-button:hover,
  .cookie-button:focus-visible {
    filter: brightness(1.06);
    transform: translateY(-1px);
  }

  .cookie-actions > a {
