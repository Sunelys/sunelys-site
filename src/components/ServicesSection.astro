---
interface ServiceCard {
  label: string;
  title: string;
  code?: string;
  stage?: string;
  price?: string;
  priceNote?: string;
  decisionHint?: string;
  benefit: string;
  description: string;
  ctaLabel: string;
  href: string;
  track: string;
}

interface BuyingSignal {
  label: string;
  text: string;
  href?: string;
  track?: string;
}

interface PricingData {
  eyebrow: string;
  text: string;
  href: string;
  label: string;
  track: string;
}

interface Props {
  data: {
    kicker: string;
    title: string;
    pricing?: PricingData;
    buyingSignals?: BuyingSignal[];
    cards: ServiceCard[];
  };
}

const { data } = Astro.props;
---

<section
  id="services"
  class="section-shell services-section reveal"
  aria-labelledby="services-title"
  data-track-view="homepage_services_view"
  data-track-label="homepage_services"
>
  <div class="services-head" data-reveal-item>
    <div class="services-lead">
      <p class="kicker">{data.kicker}</p>
      <h2 id="services-title">{data.title}</h2>
    </div>

    {
      data.pricing && (
        <aside class="pricing-note">
          <span>{data.pricing.eyebrow}</span>
          <p>{data.pricing.text}</p>
          <a href={data.pricing.href} data-track={data.pricing.track}>
            {data.pricing.label}
            <span aria-hidden="true">→</span>
          </a>
        </aside>
      )
    }
  </div>

  <div class="service-directory">
    {
      data.cards.map((card) => (
        <details class="service-entry" name="home-services">
          <summary data-track="homepage_service_expand" data-track-label={card.title}>
            <span class="service-number" aria-hidden="true">{card.label.replace(/^Service\s*/i, "")}</span>
            <span class="service-entry-title">
              {card.stage && <small>{card.stage}</small>}
              <strong>{card.title}</strong>
            </span>
            <span class="service-entry-price">
              <strong>{card.price}</strong>
              {card.priceNote && <small>{card.priceNote}</small>}
            </span>
            <span class="disclosure-symbol" aria-hidden="true">+</span>
          </summary>
          <div class="service-entry-details">
            <p class="benefit">{card.benefit}</p>
            <p class="description">{card.description}</p>
            {card.decisionHint && <p class="service-decision">{card.decisionHint}</p>}
            <a class="service-link" href={card.href} data-track={card.track} data-track-label={card.title}>
              {card.ctaLabel}
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </details>
      ))
    }
  </div>
</section>
