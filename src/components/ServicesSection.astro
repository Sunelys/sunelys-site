---
import SwipeCue from "./SwipeCue.astro";

interface ServiceCard {
  label: string;
  title: string;
  code?: string;
  stage?: string;
  price?: string;
  priceNote?: string;
  decisionHint?: string;
  benefit: string;
  description: string;
  ctaLabel: string;
  href: string;
  track: string;
}

interface BuyingSignal {
  label: string;
  text: string;
  href?: string;
  track?: string;
}

interface PricingData {
  eyebrow: string;
  text: string;
  href: string;
  label: string;
  track: string;
}

interface Props {
  data: {
    kicker: string;
    title: string;
    pricing?: PricingData;
    buyingSignals?: BuyingSignal[];
    cards: ServiceCard[];
  };
}

const { data } = Astro.props;
---

<section
  id="services"
  class="section-shell services-section reveal"
  aria-labelledby="services-title"
  data-track-view="homepage_services_view"
  data-track-label="homepage_services"
>
  <div class="services-head" data-reveal-item>
    <div class="services-lead">
      <p class="kicker">{data.kicker}</p>
      <h2 id="services-title">{data.title}</h2>
    </div>

    {
      data.pricing && (
        <aside class="pricing-note">
          <span>{data.pricing.eyebrow}</span>
          <p>{data.pricing.text}</p>
          <a href={data.pricing.href} data-track={data.pricing.track}>
            {data.pricing.label}
            <span aria-hidden="true">→</span>
          </a>
        </aside>
      )
    }
  </div>

  {
    data.buyingSignals?.length && (
      <div class="services-decision-strip" aria-label="Repères de décision Sunelys" data-reveal-item>
        {data.buyingSignals.map((signal) =>
          signal.href ? (
            <a class="decision-signal" href={signal.href} data-track={signal.track || "cta_services_decision_signal"}>
              <span>{signal.label}</span>
              <strong>{signal.text}</strong>
              <i aria-hidden="true">→</i>
            </a>
          ) : (
            <div class="decision-signal">
              <span>{signal.label}</span>
              <strong>{signal.text}</strong>
            </div>
          ),
        )}
      </div>
    )
  }

  <SwipeCue label="5 briques à parcourir" />

  <div
    class="services-grid"
    aria-label="Briques administratives Sunelys — utilisez les flèches horizontales pour les parcourir"
    tabindex="0"
    data-scroll-rail
    data-scroll-label="briques_administratives"
  >
    {
      data.cards.map((card, index) => (
        <article class:list={["service-card", index === 0 && "is-anchor-card"]} data-reveal-item>
          <div class="service-card-mark" aria-hidden="true">
            <span>{card.code ?? card.title.slice(0, 2).toUpperCase()}</span>
            <i></i>
          </div>

          <div class="card-top">
            <span>{card.label.replace(/^Service\s*/i, "")}</span>
            {card.stage && <p>{card.stage}</p>}
          </div>

          <div class="service-copy">
            <h3>{card.title}</h3>
            <p class="benefit">{card.benefit}</p>
            <p class="description">{card.description}</p>
          </div>

          {
            card.price && (
              <div class="service-commerce" aria-label={`Repère tarifaire ${card.title}`}>
                <div>
                  <span>Repère tarif</span>
                  <strong>{card.price}</strong>
                  {card.priceNote && <small>{card.priceNote}</small>}
                </div>
                {card.decisionHint && <p>{card.decisionHint}</p>}
              </div>
            )
          }

          <div class="service-foot">
            <a class="service-link" href={card.href} data-track={card.track} data-track-label={card.title}>
              {card.ctaLabel}
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .services-section {
    position: relative;
    display: grid;
    gap: 1.15rem;
    overflow: hidden;
    padding: 1.7rem;
    border: 1px solid color-mix(in srgb, var(--accent) 14%, var(--line));
    border-radius: var(--radius-xl);
    background:
      radial-gradient(85% 120% at 0% 0%, color-mix(in srgb, var(--system-soft) 40%, transparent), transparent 62%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.98), color-mix(in srgb, var(--accent-soft) 10%, white));
    box-shadow: var(--shadow-sm);
  }

  .services-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 0.42fr);
    gap: 1rem;
    align-items: stretch;
  }

  .services-lead {
    display: grid;
    gap: 0.55rem;
    align-content: start;
  }

  .kicker {
    margin: 0;
    color: var(--system);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h2 {
    max-width: 15ch;
    margin: 0;
    font-size: clamp(2.35rem, 4vw, 3.18rem);
    letter-spacing: 0;
    line-height: 1.02;
    text-wrap: balance;
  }

  .pricing-note {
    align-self: stretch;
    display: grid;
    align-content: space-between;
    gap: 1rem;
    min-height: 12.5rem;
    padding: 1.3rem;
    border-radius: 18px;
    background:
      radial-gradient(95% 95% at 100% 0%, rgba(54, 98, 227, 0.32), transparent 62%),
      linear-gradient(160deg, var(--ink-soft), var(--ink));
    box-shadow: 0 18px 36px rgba(14, 23, 38, 0.1);
  }

  .pricing-note span {
    color: var(--accent);
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .pricing-note p {
    margin: 0;
    color: rgba(255, 255, 255, 0.88);
    font-size: 0.98rem;
    font-weight: 650;
    line-height: 1.55;
  }

  .pricing-note a,
  .service-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
    font-size: 0.79rem;
    font-weight: 780;
    text-decoration: none;
  }

  .pricing-note a {
    color: #ffffff;
  }

  .pricing-note a span,
  .service-link span {
    font-size: 1rem;
    transition: transform 160ms ease;
  }

  .pricing-note a span {
    color: var(--accent);
  }

  .service-link span {
    color: var(--system);
  }

  .pricing-note a:hover span,
  .service-link:hover span {
    transform: translateX(3px);
  }

  .services-decision-strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .decision-signal {
    position: relative;
    display: grid;
    gap: 0.42rem;
    min-height: 6rem;
    padding: 1rem 1.05rem;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--system) 10%, var(--line));
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.82);
    color: var(--ink);
    text-decoration: none;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.7);
  }

  .decision-signal::before {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 2px;
    background: linear-gradient(90deg, var(--system), color-mix(in srgb, var(--accent) 62%, white));
    opacity: 0.84;
  }

  .decision-signal span {
    color: var(--system);
    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .decision-signal strong {
    max-width: 28ch;
    color: var(--text);
    font-size: 0.94rem;
    line-height: 1.35;
  }

  .decision-signal i {
    position: absolute;
    right: 0.95rem;
    top: 0.95rem;
    color: var(--accent-strong);
    font-style: normal;
    transition: transform 160ms ease;
  }

  .decision-signal:hover i {
    transform: translateX(3px);
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(10, minmax(0, 1fr));
    gap: 0.8rem;
  }

  .service-card {
    position: relative;
    grid-column: span 2;
    min-width: 0;
    min-height: 23.2rem;
    display: grid;
    grid-template-rows: auto auto minmax(0, 1fr) auto auto;
    gap: 1.2rem;
    padding: 1.2rem;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--system) 10%, var(--line));
    border-radius: 18px;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.96), rgba(255, 255, 255, 0.88)),
      rgba(255, 255, 255, 0.88);
    box-shadow: 0 12px 28px rgba(14, 23, 38, 0.05);
    transition:
      transform 170ms ease,
      border-color 170ms ease,
      box-shadow 170ms ease,
      background-color 170ms ease;
  }

  .service-card::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 3px;
    background: var(--system);
  }

  .service-card:nth-child(even)::before {
    background: var(--accent);
  }

  .service-card.is-anchor-card {
    background:
      radial-gradient(110% 120% at 0% 0%, color-mix(in srgb, var(--system-soft) 48%, transparent), transparent 64%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(255, 255, 255, 0.9));
  }

  .service-card:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--system) 24%, var(--line));
    box-shadow: 0 18px 36px rgba(14, 23, 38, 0.08);
  }

  .service-card-mark {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    color: var(--system);
  }

  .service-card:nth-child(even) .service-card-mark {
    color: var(--accent-strong);
  }

  .service-card-mark span {
    display: inline-grid;
    place-items: center;
    width: 2.9rem;
    height: 2.9rem;
    border: 1px solid color-mix(in srgb, var(--system) 18%, var(--line));
    border-radius: 14px;
    background: color-mix(in srgb, var(--system-soft) 56%, white);
    font-size: 0.68rem;
    font-weight: 850;
    letter-spacing: 0.04em;
  }

  .service-card:nth-child(even) .service-card-mark span {
    border-color: color-mix(in srgb, var(--accent) 24%, var(--line));
    background: color-mix(in srgb, var(--accent-soft) 68%, white);
  }

  .service-card-mark i {
    width: 2.6rem;
    height: 1px;
    background: linear-gradient(90deg, color-mix(in srgb, var(--system) 62%, transparent), transparent);
    transition: width 170ms ease;
  }

  .service-card:nth-child(even) .service-card-mark i {
    background: linear-gradient(90deg, color-mix(in srgb, var(--accent) 78%, transparent), transparent);
  }

  .service-card:hover .service-card-mark i {
    width: 4rem;
  }

  .service-card:nth-child(-n + 3) {
    grid-column: span 3;
  }

  .service-card:nth-child(4),
  .service-card:nth-child(5) {
    grid-column: span 5;
    min-height: 19.75rem;
  }

  .card-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.8rem;
  }

  .card-top span {
    color: var(--system);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .card-top p {
    margin: 0;
    padding: 0.34rem 0.5rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--system-soft) 68%, white);
    color: var(--system);
    font-size: 0.63rem;
    font-weight: 780;
    text-transform: uppercase;
  }

  .service-copy {
    display: grid;
    gap: 0.72rem;
    align-content: start;
  }

  .service-card h3 {
    max-width: 13ch;
    margin: 0;
    font-size: 1.72rem;
    letter-spacing: 0;
    line-height: 1.04;
    text-wrap: balance;
  }

  .benefit {
    max-width: 40ch;
    margin: 0;
    color: var(--text);
    font-size: 0.87rem;
    font-weight: 720;
    line-height: 1.52;
  }

  .description {
    max-width: 54ch;
    margin: 0;
    color: var(--text-muted);
    font-size: 0.79rem;
    line-height: 1.58;
  }

  .service-commerce {
    display: grid;
    gap: 0.58rem;
    padding: 0.9rem;
    border: 1px solid color-mix(in srgb, var(--accent) 20%, var(--line));
    border-radius: 16px;
    background:
      radial-gradient(95% 130% at 100% 0%, color-mix(in srgb, var(--accent-soft) 52%, transparent), transparent 68%),
      color-mix(in srgb, var(--surface) 96%, white);
  }

  .service-commerce div {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem;
  }

  .service-commerce span {
    color: var(--accent-strong);
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .service-commerce strong {
    color: var(--ink);
    font-size: 1.2rem;
    line-height: 1;
  }

  .service-commerce small {
    color: var(--text-muted);
    font-size: 0.72rem;
    font-weight: 720;
  }

  .service-commerce p {
    margin: 0;
    color: var(--text);
    font-size: 0.73rem;
    font-weight: 690;
    line-height: 1.45;
  }

  .service-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.9rem;
    border-top: 1px solid color-mix(in srgb, var(--system) 10%, var(--line));
  }

  .service-link {
    color: var(--ink);
  }

  @media (max-width: 1100px) {
    .services-head {
      grid-template-columns: 1fr;
    }

    .services-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .service-card,
    .service-card:nth-child(-n + 3),
    .service-card:nth-child(4),
    .service-card:nth-child(5) {
      grid-column: span 1;
      min-height: 0;
    }
  }

  @media (max-width: 760px) {
    .services-section {
      padding: 1.2rem;
      border-radius: 18px;
    }

    .services-decision-strip {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 620px) {
    .services-section {
      gap: 0.95rem;
      padding: 1rem;
    }

    h2 {
      font-size: 2.14rem;
    }

    .pricing-note {
      min-height: 0;
      padding: 1rem;
      border-radius: 16px;
    }

    .pricing-note p {
      font-size: 0.92rem;
    }

    .services-grid {
      grid-template-columns: none;
      grid-auto-flow: column;
      overflow-x: auto;
      gap: 0.7rem;
      scroll-snap-type: x mandatory;
      overscroll-behavior-inline: contain;
      scrollbar-width: none;
      scroll-padding-inline: 0.15rem;
      padding-bottom: 0.35rem;
    }

    .services-grid::-webkit-scrollbar {
      display: none;
    }

    .services-grid:focus-visible {
      outline: 3px solid color-mix(in srgb, var(--system) 34%, transparent);
      outline-offset: 3px;
    }

    .service-card,
    .service-card:nth-child(-n + 3),
    .service-card:nth-child(4),
    .service-card:nth-child(5) {
      width: min(79vw, 20.5rem);
      min-height: 22rem;
      scroll-snap-align: start;
    }

    .service-card {
      padding: 1rem;
      border-radius: 16px;
    }

    .service-card h3 {
      font-size: 1.48rem;
    }

    .decision-signal {
      min-height: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pricing-note a span,
    .service-link span,
    .decision-signal i,
    .service-card,
    .service-card-mark i {
      transition: none;
    }
  }
</style>
