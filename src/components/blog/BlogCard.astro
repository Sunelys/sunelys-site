---
import ResponsiveImage from "../ResponsiveImage.astro";
interface Props {
  post: { frontmatter: { slug: string; title: string; description: string; pubDate: string; category: string; readingTime: string; coverImage?: string; coverAlt?: string } };
}
const { post } = Astro.props;
const data = post.frontmatter;
const articleHref = `/blog/${data.slug}`;
const date = new Intl.DateTimeFormat("fr-FR", { day: "2-digit", month: "short", year: "numeric" }).format(new Date(data.pubDate));
---
<article class="guide-card" data-guide-card data-guide-title={data.title} data-guide-description={data.description} data-guide-category={data.category}>
  <a class="guide-card-image" href={articleHref} tabindex="-1" aria-hidden="true">
    {data.coverImage && <ResponsiveImage src={data.coverImage} alt={data.coverAlt || data.title} width="1280" height="720" sizes="(max-width: 760px) 112px, (max-width: 1000px) 42vw, 380px" />}
  </a>
  <div class="guide-card-body">
    <div class="guide-card-meta"><span>{data.category}</span><span>{data.readingTime}</span></div>
    <h3><a href={articleHref} data-track="cta_blog_card" data-track-label={data.slug}>{data.title}</a></h3>
    <p>{data.description}</p>
    <footer><time datetime={data.pubDate}>{date}</time><span aria-hidden="true">→</span></footer>
  </div>
</article>
<style>
  .guide-card { min-width: 0; display: flex; flex-direction: column; border-bottom: 1px solid var(--line); padding-bottom: 20px; }
  .guide-card[hidden] { display: none !important; }
  .guide-card-image { display: block; aspect-ratio: 16 / 10; overflow: hidden; background: var(--surface); border-radius: 4px; }
  .guide-card-body { display: flex; flex-direction: column; flex: 1; }
  .guide-card-meta { display: flex; flex-wrap: wrap; gap: 4px 12px; margin: 16px 0 12px; color: var(--text-muted); font-size: 14px; }
  .guide-card-meta span:first-child { color: var(--accent-text); }
  h3 { font-size: 23px; line-height: 1.25; margin: 0; }
  h3 a { color: var(--text); text-decoration: none; }
  h3 a:hover { text-decoration: underline; }
  .guide-card-body > p { color: var(--text-muted); font-size: 16px; line-height: 1.5; margin: 12px 0 16px; }
  footer { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-top: auto; padding-top: 16px; color: var(--text-muted); font-size: 14px; }
  footer > span { font-size: 20px; color: var(--accent-text); }
  @media (max-width: 760px) {
    .guide-card { display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 20px; padding-block: 24px; }
    .guide-card-image { aspect-ratio: 1; }
    .guide-card-meta { margin: 0 0 8px; }
    h3 { font-size: 21px; }
    .guide-card-body > p { display: none; }
    footer { padding-top: 12px; }
  }
  @media (max-width: 380px) { .guide-card { grid-template-columns: 72px minmax(0, 1fr); gap: 16px; } h3 { font-size: 20px; } }
</style>
