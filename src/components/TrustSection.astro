---
interface Props {
  data: {
    kicker: string;
    title: string;
    trustNote?: string;
    handoff: {
      title: string;
      items: { label: string; text: string }[];
      cta: { label: string; href: string; track: string };
    };
  };
}

const { data } = Astro.props;
---

<section class="section-shell trust-section reveal" aria-labelledby="trust-title" data-track-view="homepage_trust_bridge_view" data-track-label="homepage_trust_bridge">
  <figure class="team-presence">
    <picture>
      <source type="image/avif" srcset="/images/site/founder-variants/myriam-zaoui-founder-variant-c-institutional-2026-07-29.avif" />
      <img src="/images/site/founder-variants/myriam-zaoui-founder-variant-c-institutional-2026-07-29.png" alt="Myriam Zaoui, fondatrice de Sunelys" width="971" height="1619" loading="lazy" decoding="async" />
    </picture>
    <figcaption>
      <strong>Myriam Zaoui</strong>
      <span>Fondatrice de Sunelys</span>
      <span>Votre interlocutrice sur le cadrage initial.</span>
    </figcaption>
  </figure>
  <div class="team-copy">
    <p class="kicker">{data.kicker}</p>
    <h2 id="trust-title">{data.title}</h2>
    <p class="trust-note">{data.trustNote}</p>
    <details class="handoff-details">
      <summary>{data.handoff.title}<span class="disclosure-symbol" aria-hidden="true">+</span></summary>
      <dl>
        {data.handoff.items.map((item) => (<div><dt>{item.label}</dt><dd>{item.text}</dd></div>))}
      </dl>
    </details>
    <a class="handoff-link" href={data.handoff.cta.href} data-track={data.handoff.cta.track}>{data.handoff.cta.label}<span aria-hidden="true">→</span></a>
  </div>
</section>
