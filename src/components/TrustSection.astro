---
import SwipeCue from "./SwipeCue.astro";

interface LogoItem {
  name: string;
  src: string;
  width: number;
  height: number;
}

interface MetricItem {
  value: string;
  label: string;
}

interface AssuranceItem {
  label: string;
  text: string;
}

interface HandoffItem {
  label: string;
  text: string;
}

interface DecisionPathItem {
  title: string;
  text: string;
  href: string;
  track: string;
}

interface Props {
  data: {
    kicker: string;
    title: string;
    logos: LogoItem[];
    metrics: MetricItem[];
    assurances?: AssuranceItem[];
    trustNote?: string;
    handoff?: {
      kicker: string;
      title: string;
      items: HandoffItem[];
      cta: {
        label: string;
        href: string;
        track: string;
      };
    };
    decisionPath?: DecisionPathItem[];
  };
}

const { data } = Astro.props;
const visibleLogos = data.logos.filter((logo) => logo.src);
const assurances =
  data.assurances && data.assurances.length > 0
    ? data.assurances
    : [
        {
          label: "Cadre clair",
          text: "Vous savez quelle démarche reprendre en priorité avant de lancer la suite.",
        },
        {
          label: "Suivi lisible",
          text: "Les pièces, les relances et les statuts restent visibles pour vos équipes.",
        },
        {
          label: "Délégation souple",
          text: "Un dossier ponctuel, un pic de charge ou un flux récurrent peuvent être cadrés.",
        },
      ];
const handoff = data.handoff ?? {
  kicker: "Après votre envoi",
  title: "Un premier cadrage exploitable, pas un échange flou.",
  items: [
    { label: "Périmètre", text: "La démarche à reprendre en priorité." },
    { label: "Pièces", text: "Les points à vérifier avant dépôt ou relance." },
    { label: "Suite", text: "Le forfait et le suivi adaptés à votre contexte." },
  ],
  cta: {
    label: "Choisir mon périmètre",
    href: "#hero-lead-form",
    track: "cta_trust_bridge_hero_form",
  },
};
const decisionPath = data.decisionPath ?? [
  {
    title: "Cadrer le blocage",
    text: "Vous indiquez le dossier ou le flux qui vous ralentit.",
    href: "#hero-lead-form",
    track: "cta_trust_path_diagnostic",
  },
  {
    title: "Choisir la reprise",
    text: "Sunelys identifie le bon niveau de délégation.",
    href: "#parcours",
    track: "cta_trust_path_method",
  },
  {
    title: "Lancer le service",
    text: "DP, Consuel, raccordement ou pilotage complet.",
    href: "#services",
    track: "cta_trust_path_services",
  },
];
---

<section
  class="section-shell trust-section reveal"
  aria-labelledby="trust-title"
  data-track-view="homepage_trust_bridge_view"
  data-track-label="homepage_trust_bridge"
>
  <div class="trust-bridge">
    <div class="trust-story" data-reveal-item>
      <p class="kicker">{data.kicker}</p>
      <h2 id="trust-title">{data.title}</h2>

      <p class="trust-note">
        {data.trustNote ?? "Des dossiers suivis, des pièces mieux cadrées et une visibilité plus claire pour les équipes."}
      </p>

      <div class="assurance-grid" aria-label="Engagements Sunelys">
        {
          assurances.map((item) => (
            <article>
              <strong>{item.label}</strong>
              <p>{item.text}</p>
            </article>
          ))
        }
      </div>
    </div>

    <aside class="handoff-panel" aria-label="Ce que Sunelys vous renvoie après votre demande" data-reveal-item>
      <div class="handoff-top">
        <div>
          <p class="panel-kicker">{handoff.kicker}</p>
          <h3>{handoff.title}</h3>
        </div>

        <ol class="handoff-list">
          {
            handoff.items.map((item, index) => (
              <li>
                <span>0{index + 1}</span>
                <div>
                  <strong>{item.label}</strong>
                  <p>{item.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>

      <div class="handoff-bottom">
        <div class="handoff-signature">
          <picture class="handoff-portrait">
            <img
              src="/images/site/founder-variants/myriam-zaoui-founder-variant-c-institutional-2026-07-29.png"
              alt="Myriam Zaoui, fondatrice de Sunelys"
              width="971"
              height="1619"
              loading="lazy"
              decoding="async"
            />
          </picture>

          <div>
            <strong>Myriam Zaoui</strong>
            <p>Fondatrice de Sunelys et interlocutrice unique sur le cadrage initial.</p>
          </div>
        </div>

        <a class="handoff-link" href={handoff.cta.href} data-track={handoff.cta.track}>
          {handoff.cta.label}
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </aside>
  </div>

  <div class="decision-path" aria-label="Chemin de décision Sunelys" data-reveal-item>
    <header>
      <span>Suite naturelle</span>
      <strong>Du premier blocage au bon service, sans flou ni allers-retours.</strong>
    </header>

    <ol>
      {
        decisionPath.map((item, index) => (
          <li>
            <a href={item.href} data-track={item.track}>
              <span>0{index + 1}</span>
              <div>
                <strong>{item.title}</strong>
                <p>{item.text}</p>
              </div>
              <em aria-hidden="true">→</em>
            </a>
          </li>
        ))
      }
    </ol>
  </div>

  <SwipeCue label="4 preuves opérationnelles à parcourir" />

  <div
    class="trust-metrics"
    aria-label="Preuves opérationnelles Sunelys — utilisez les flèches horizontales pour les parcourir"
    tabindex="0"
    data-scroll-rail
    data-scroll-label="preuves_operationnelles"
    data-reveal-item
  >
    {
      data.metrics.map((metric, index) => (
        <article class:list={["metric", index === 0 && "is-featured"]}>
          <span class="metric-index">0{index + 1}</span>
          <strong>{metric.value}</strong>
          <p>{metric.label}</p>
        </article>
      ))
    }
  </div>

  {
    visibleLogos.length > 0 && (
      <div class="logo-wall" aria-label="Clients Sunelys" data-reveal-item>
        <div class="logo-wall-head">
          <p>Installateurs accompagnés</p>
          <span>Des structures qui confient déjà leur administratif solaire à Sunelys.</span>
        </div>

        <div class="logo-row">
          {
            visibleLogos.map((logo) => (
              <div class="logo-slot" title={logo.name}>
                <img
                  src={logo.src}
                  alt={logo.name}
                  width={logo.width}
                  height={logo.height}
                  loading="lazy"
                  decoding="async"
                />
              </div>
            ))
          }
        </div>
      </div>
    )
  }
</section>

<style>
  .trust-section {
    display: grid;
    gap: 1.15rem;
    padding: 1.7rem;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--accent) 16%, var(--line));
    border-radius: var(--radius-xl);
    background:
      radial-gradient(75% 120% at 0% 0%, color-mix(in srgb, var(--accent-soft) 42%, transparent), transparent 58%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.98), color-mix(in srgb, var(--accent-soft) 12%, white));
    box-shadow: var(--shadow-sm);
  }

  .trust-bridge {
    display: grid;
    grid-template-columns: minmax(0, 1.06fr) minmax(340px, 0.94fr);
    gap: 1rem;
    align-items: stretch;
  }

  .trust-story {
    display: grid;
    align-content: start;
    gap: 1rem;
    min-height: 24rem;
    padding: 2.2rem;
    border: 1px solid color-mix(in srgb, var(--system) 10%, var(--line));
    border-radius: calc(var(--radius-xl) - 6px);
    background: rgba(255, 255, 255, 0.72);
  }

  .kicker {
    margin: 0;
    color: var(--system);
    font-size: 0.7rem;
    font-weight: 780;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h2 {
    max-width: 16ch;
    margin: 0;
    font-size: 2.72rem;
    letter-spacing: 0;
    line-height: 1.04;
  }

  .trust-note {
    max-width: 58ch;
    color: var(--text-muted);
    font-size: 0.98rem;
    line-height: 1.68;
  }

  .assurance-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 0.25rem;
  }

  .assurance-grid article {
    display: grid;
    gap: 0.34rem;
    min-width: 0;
    padding: 1rem;
    border: 1px solid color-mix(in srgb, var(--system) 10%, var(--line));
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.86);
  }

  .assurance-grid strong {
    color: var(--text);
    font-size: 0.88rem;
    line-height: 1.3;
  }

  .assurance-grid p {
    color: var(--text-muted);
    font-size: 0.78rem;
    line-height: 1.5;
  }

  .handoff-panel {
    display: grid;
    align-content: space-between;
    gap: 1.2rem;
    min-height: 24rem;
    padding: 2rem;
    border-radius: calc(var(--radius-xl) - 6px);
    background:
      radial-gradient(88% 92% at 100% 0%, rgba(54, 98, 227, 0.34), transparent 58%),
      linear-gradient(160deg, var(--ink-soft), var(--ink));
    box-shadow: 0 20px 40px rgba(14, 23, 38, 0.12);
    color: #ffffff;
  }

  .handoff-top {
    display: grid;
    gap: 1rem;
  }

  .panel-kicker {
    margin: 0;
    color: var(--accent);
    font-size: 0.7rem;
    font-weight: 780;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .handoff-panel h3 {
    max-width: 14ch;
    margin: 0.55rem 0 0;
    color: #ffffff;
    font-size: 1.88rem;
    letter-spacing: 0;
    line-height: 1.08;
  }

  .handoff-list {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .handoff-list li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.82rem;
    padding: 0.85rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .handoff-list li:last-child {
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .handoff-list span {
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 10px;
    color: var(--accent);
    font-size: 0.68rem;
    font-weight: 780;
  }

  .handoff-list strong {
    display: block;
    color: #ffffff;
    font-size: 0.9rem;
  }

  .handoff-list p {
    margin-top: 0.14rem;
    color: rgba(255, 255, 255, 0.68);
    font-size: 0.78rem;
    line-height: 1.48;
  }

  .handoff-bottom {
    display: grid;
    gap: 0.9rem;
  }

  .handoff-signature {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.8rem;
    align-items: center;
    padding: 0.85rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.06);
  }

  .handoff-portrait {
    width: 3.7rem;
    height: 3.7rem;
    overflow: hidden;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.08);
  }

  .handoff-portrait img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .handoff-signature strong {
    display: block;
    color: #ffffff;
    font-size: 0.84rem;
    line-height: 1.2;
  }

  .handoff-signature p {
    margin-top: 0.18rem;
    color: rgba(255, 255, 255, 0.64);
    font-size: 0.72rem;
    line-height: 1.45;
  }

  .handoff-link {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    min-height: 2.95rem;
    padding: 0.8rem 0.98rem;
    border-radius: 12px;
    background: var(--accent);
    color: var(--ink);
    font-size: 0.84rem;
    font-weight: 780;
    text-decoration: none;
    box-shadow: var(--shadow-accent);
  }

  .handoff-link span {
    font-size: 1rem;
  }

  .decision-path {
    display: grid;
    gap: 0.9rem;
    padding: 1.05rem 1.15rem;
    border: 1px solid color-mix(in srgb, var(--system) 13%, var(--line));
    border-radius: calc(var(--radius-xl) - 6px);
    background: rgba(255, 255, 255, 0.74);
  }

  .decision-path header {
    display: grid;
    gap: 0.3rem;
  }

  .decision-path header span {
    color: var(--system);
    font-size: 0.62rem;
    font-weight: 820;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .decision-path header strong {
    color: var(--text);
    font-size: 1.08rem;
    line-height: 1.35;
    text-wrap: balance;
  }

  .decision-path ol {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .decision-path li {
    min-width: 0;
  }

  .decision-path a {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0.64rem;
    align-items: center;
    min-height: 100%;
    padding: 0.95rem;
    border: 1px solid color-mix(in srgb, var(--system) 11%, var(--line));
    border-radius: 14px;
    background: #ffffff;
    color: var(--text);
    text-decoration: none;
    transition: border-color 160ms ease, transform 160ms ease, box-shadow 160ms ease;
  }

  .decision-path a:hover,
  .decision-path a:focus-visible {
    border-color: color-mix(in srgb, var(--system) 34%, var(--line));
    transform: translateY(-1px);
    box-shadow: var(--shadow-sm);
  }

  .decision-path a > span {
    color: var(--accent-deep);
    font-size: 0.68rem;
    font-weight: 820;
  }

  .decision-path a strong {
    display: block;
    color: var(--text);
    font-size: 0.8rem;
    line-height: 1.3;
  }

  .decision-path a p {
    margin-top: 0.2rem;
    color: var(--text-muted);
    font-size: 0.68rem;
    line-height: 1.4;
  }

  .decision-path a em {
    color: var(--system);
    font-size: 0.9rem;
    font-style: normal;
    font-weight: 800;
  }

  .trust-metrics {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.8rem;
  }

  .metric {
    min-height: 8.8rem;
    padding: 1rem 1.05rem;
    display: grid;
    align-content: space-between;
    gap: 0.6rem;
    border: 1px solid color-mix(in srgb, var(--system) 10%, var(--line));
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.84);
  }

  .metric.is-featured {
    background:
      radial-gradient(90% 120% at 100% 0%, rgba(212, 130, 42, 0.18), transparent 64%),
      linear-gradient(160deg, color-mix(in srgb, var(--ink-soft) 96%, white), var(--ink));
  }

  .metric-index {
    color: var(--system);
    font-size: 0.68rem;
    font-weight: 780;
  }

  .metric strong {
    color: var(--text);
    font-size: 2.45rem;
    font-weight: 720;
    letter-spacing: 0;
    line-height: 0.95;
  }

  .metric.is-featured .metric-index {
    color: rgba(255, 255, 255, 0.72);
  }

  .metric.is-featured strong {
    color: #ffffff;
  }

  .metric p {
    max-width: 24ch;
    color: var(--text-muted);
    font-size: 0.78rem;
    line-height: 1.46;
  }

  .metric.is-featured p {
    color: rgba(255, 255, 255, 0.68);
  }

  .logo-wall {
    display: grid;
    gap: 0.75rem;
    padding: 1rem 1.1rem;
    border: 1px solid color-mix(in srgb, var(--system) 10%, var(--line));
    border-radius: calc(var(--radius-xl) - 6px);
    background: rgba(255, 255, 255, 0.76);
  }

  .logo-wall-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .logo-wall-head p,
  .logo-wall-head span {
    margin: 0;
  }

  .logo-wall-head p {
    color: var(--text);
    font-size: 0.78rem;
    font-weight: 760;
  }

  .logo-wall-head span {
    color: var(--text-muted);
    font-size: 0.74rem;
  }

  .logo-row {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.55rem;
  }

  .logo-slot {
    min-height: 4rem;
    display: grid;
    place-items: center;
    padding: 0.65rem;
    border: 1px solid color-mix(in srgb, var(--system) 8%, var(--line));
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.8);
  }

  .logo-slot img {
    display: block;
    width: auto;
    max-width: 100%;
    max-height: 2rem;
    object-fit: contain;
  }

  @media (max-width: 1080px) {
    .trust-bridge {
      grid-template-columns: 1fr;
    }

    .assurance-grid,
    .trust-metrics,
    .decision-path ol,
    .logo-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .trust-section {
      padding: 1rem;
      border-radius: 18px;
    }

    .trust-story,
    .handoff-panel {
      min-height: 0;
      padding: 1.2rem;
      border-radius: 16px;
    }

    h2 {
      font-size: 2.15rem;
    }

    .trust-note {
      font-size: 0.92rem;
      line-height: 1.58;
    }

    .assurance-grid,
    .decision-path ol,
    .trust-metrics,
    .logo-row {
      grid-template-columns: 1fr;
    }

    .logo-wall-head {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.28rem;
    }

    .decision-path {
      padding: 0.95rem;
    }

    .handoff-panel h3 {
      font-size: 1.48rem;
    }

    .handoff-signature {
      grid-template-columns: auto 1fr;
    }

    .handoff-link {
      width: 100%;
    }
  }
</style>
