---
import SwipeCue from "./SwipeCue.astro";

interface MethodItem {
  label: string;
  text: string;
  signal?: string;
}

interface StepItem {
  title: string;
  text: string;
  phase?: string;
}

interface Props {
  data: {
    kicker: string;
    title: string;
    text: string;
    audiences: MethodItem[];
    steps: StepItem[];
    cta: {
      label: string;
      href: string;
      track: string;
    };
  };
}

const { data } = Astro.props;
const fallbackPhases = ["Entrée", "Cadrage", "Production", "Visibilité"];
---

<section
  id="parcours"
  class="method-section section-shell reveal"
  aria-labelledby="method-title"
  data-track-view="homepage_method_view"
  data-track-label="homepage_method"
>
  <div class="method-lead" data-reveal-item>
    <div class="method-copy">
      <p class="kicker">{data.kicker}</p>
      <h2 id="method-title">{data.title}</h2>
    </div>

    <div class="method-summary">
      <p class="intro">{data.text}</p>

      <div class="method-promises" aria-label="Principe de pilotage Sunelys">
        <span>Vous choisissez le périmètre</span>
        <span>Sunelys reprend la production</span>
        <span>Vous gardez la visibilité</span>
      </div>

      <a class="method-link" href={data.cta.href} data-track={data.cta.track}>
        {data.cta.label}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>

  <div class="method-workspace" data-reveal-item>
    <div class="mode-panel">
      <div class="panel-head">
        <div>
          <p>Modes de reprise</p>
          <h3>Trois niveaux, un même cadre.</h3>
        </div>
        <span>3 formats</span>
      </div>

      <SwipeCue label="3 formats de délégation" />

      <div
        class="audience-list"
        aria-label="Formats de délégation Sunelys — utilisez les flèches horizontales pour les parcourir"
        tabindex="0"
        data-scroll-rail
        data-scroll-label="formats_delegation"
      >
        {
          data.audiences.map((item, index) => (
            <article>
              <span class="mode-index">0{index + 1}</span>
              <div>
                <h4>{item.label}</h4>
                {item.signal && <strong>{item.signal}</strong>}
                <p>{item.text}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>

    <div class="operations-panel">
      <div class="panel-head panel-head-dark">
        <div>
          <p>Vue de pilotage</p>
          <h3>Ce qui avance après le cadrage.</h3>
        </div>
        <span>4 temps</span>
      </div>

      <SwipeCue label="Le parcours en 4 temps" tone="dark" />

      <ol
        class="steps-board"
        aria-label="Parcours Sunelys en quatre temps — utilisez les flèches horizontales pour les parcourir"
        tabindex="0"
        data-scroll-rail
        data-scroll-label="parcours_4_temps"
      >
        {
          data.steps.map((step, index) => (
            <li>
              <div class="step-meta">
                <span>0{index + 1}</span>
                <strong>{step.phase ?? fallbackPhases[index] ?? "Étape"}</strong>
              </div>
              <div>
                <h4>{step.title}</h4>
                <p>{step.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .method-section {
    display: grid;
    gap: 1.1rem;
    overflow: hidden;
    padding: 1.55rem;
    border: 1px solid color-mix(in srgb, var(--system) 10%, var(--line));
    border-radius: var(--radius-xl);
    background:
      radial-gradient(80% 120% at 0% 0%, color-mix(in srgb, var(--system-soft) 32%, transparent), transparent 62%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.98), color-mix(in srgb, var(--system-soft) 18%, white));
    box-shadow: var(--shadow-sm);
  }

  .method-lead {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(360px, 1.18fr);
    gap: 1.1rem 1.8rem;
    align-items: start;
  }

  .method-copy,
  .method-summary {
    display: grid;
    gap: 0.7rem;
  }

  .kicker {
    margin: 0;
    color: var(--system);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h2 {
    max-width: 14ch;
    margin: 0;
    font-size: clamp(2.28rem, 3.8vw, 3.04rem);
    letter-spacing: 0;
    line-height: 1.03;
    text-wrap: balance;
  }

  .intro {
    max-width: 60ch;
    margin: 0;
    color: var(--text-muted);
    font-size: 0.99rem;
    line-height: 1.64;
  }

  .method-promises {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .method-promises span {
    display: inline-flex;
    align-items: center;
    min-height: 2.35rem;
    padding: 0.72rem 0.95rem;
    border: 1px solid color-mix(in srgb, var(--system) 12%, var(--line));
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.72);
    color: var(--text);
    font-size: 0.8rem;
    font-weight: 720;
    line-height: 1.25;
  }

  .method-link {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    width: fit-content;
    min-height: 2.85rem;
    padding: 0.78rem 1rem;
    border: 1px solid var(--ink);
    border-radius: 14px;
    background: var(--ink);
    color: #ffffff;
    font-size: 0.84rem;
    font-weight: 780;
    text-decoration: none;
    box-shadow: 0 16px 28px rgba(14, 23, 38, 0.09);
  }

  .method-link span {
    color: var(--accent);
    font-size: 1rem;
  }

  .method-workspace {
    display: grid;
    grid-template-columns: minmax(300px, 0.72fr) minmax(0, 1.28fr);
    gap: 0.85rem;
  }

  .mode-panel,
  .operations-panel {
    min-width: 0;
    border-radius: calc(var(--radius-xl) - 6px);
  }

  .mode-panel {
    display: grid;
    align-content: start;
    gap: 1rem;
    padding: 1.3rem;
    border: 1px solid color-mix(in srgb, var(--system) 10%, var(--line));
    background: rgba(255, 255, 255, 0.84);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.78);
  }

  .operations-panel {
    display: grid;
    gap: 1rem;
    padding: 1.3rem;
    background:
      radial-gradient(95% 100% at 100% 0%, rgba(54, 98, 227, 0.28), transparent 60%),
      linear-gradient(160deg, var(--ink-soft), var(--ink));
    color: #ffffff;
  }

  .panel-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .panel-head p,
  .panel-head h3 {
    margin: 0;
  }

  .panel-head p {
    color: var(--system);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .panel-head h3 {
    max-width: 16ch;
    margin-top: 0.38rem;
    font-size: 1.36rem;
    letter-spacing: 0;
    line-height: 1.15;
    text-wrap: balance;
  }

  .panel-head > span {
    flex: 0 0 auto;
    padding: 0.38rem 0.6rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--system-soft) 72%, white);
    color: var(--system);
    font-size: 0.66rem;
    font-weight: 780;
  }

  .panel-head-dark p {
    color: var(--accent);
  }

  .panel-head-dark h3 {
    color: #ffffff;
  }

  .panel-head-dark > span {
    background: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.68);
  }

  .audience-list {
    display: grid;
    gap: 0.7rem;
  }

  .audience-list article {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.85rem;
    min-width: 0;
    padding: 0.95rem;
    border: 1px solid color-mix(in srgb, var(--system) 10%, var(--line));
    border-radius: 16px;
    background:
      radial-gradient(95% 110% at 100% 0%, color-mix(in srgb, var(--system-soft) 42%, transparent), transparent 70%),
      rgba(255, 255, 255, 0.86);
  }

  .mode-index {
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid color-mix(in srgb, var(--system) 16%, var(--line));
    border-radius: 10px;
    color: var(--system);
    font-size: 0.68rem;
    font-weight: 820;
  }

  .audience-list h4,
  .audience-list p {
    margin: 0;
  }

  .audience-list h4 {
    color: var(--text);
    font-size: 0.96rem;
    letter-spacing: 0;
    line-height: 1.22;
  }

  .audience-list strong {
    display: block;
    margin-top: 0.28rem;
    color: var(--accent-deep);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .audience-list p {
    margin-top: 0.32rem;
    color: var(--text-muted);
    font-size: 0.79rem;
    line-height: 1.5;
  }

  .steps-board {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.65rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .steps-board li {
    position: relative;
    display: grid;
    align-content: space-between;
    gap: 1.2rem;
    min-height: 16.5rem;
    min-width: 0;
    padding: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.055);
    backdrop-filter: blur(8px);
  }

  .steps-board li + li::before {
    content: "";
    position: absolute;
    top: 2.1rem;
    left: -0.68rem;
    width: 0.68rem;
    height: 1px;
    background: rgba(255, 255, 255, 0.22);
  }

  .step-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.7rem;
  }

  .step-meta span {
    display: inline-grid;
    place-items: center;
    width: 2.15rem;
    height: 2.15rem;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 10px;
    color: var(--accent);
    font-size: 0.68rem;
    font-weight: 820;
  }

  .step-meta strong {
    color: rgba(255, 255, 255, 0.62);
    font-size: 0.68rem;
    font-weight: 780;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .steps-board h4,
  .steps-board p {
    margin: 0;
  }

  .steps-board h4 {
    color: #ffffff;
    font-size: 1.04rem;
    letter-spacing: 0;
    line-height: 1.18;
  }

  .steps-board p {
    margin-top: 0.42rem;
    color: rgba(255, 255, 255, 0.66);
    font-size: 0.8rem;
    line-height: 1.52;
  }

  @media (max-width: 1040px) {
    .method-lead,
    .method-workspace {
      grid-template-columns: 1fr;
    }

    .steps-board {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .steps-board li {
      min-height: 12.5rem;
    }

    .steps-board li + li::before {
      display: none;
    }
  }

  @media (max-width: 620px) {
    .method-section {
      gap: 1rem;
      padding: 1rem;
      border-radius: 18px;
    }

    h2 {
      font-size: 2.08rem;
    }

    .intro {
      font-size: 0.94rem;
    }

    .method-promises {
      display: grid;
    }

    .method-promises span {
      min-height: 0;
      justify-content: center;
      border-radius: 14px;
      text-align: center;
    }

    .method-link {
      width: 100%;
    }

    .mode-panel,
    .operations-panel {
      padding: 1rem;
      border-radius: 16px;
    }

    .panel-head {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.55rem;
    }

    .panel-head h3 {
      font-size: 1.18rem;
    }

    .audience-list,
    .steps-board {
      grid-template-columns: none;
      grid-auto-flow: column;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      overscroll-behavior-inline: contain;
      scrollbar-width: none;
      scroll-padding-inline: 0.15rem;
      padding-bottom: 0.45rem;
    }

    .audience-list::-webkit-scrollbar,
    .steps-board::-webkit-scrollbar {
      display: none;
    }

    .audience-list:focus-visible,
    .steps-board:focus-visible {
      outline: 3px solid color-mix(in srgb, var(--system) 34%, transparent);
      outline-offset: 3px;
    }

    .steps-board:focus-visible {
      outline-color: color-mix(in srgb, var(--accent) 64%, transparent);
    }

    .audience-list article {
      width: min(78vw, 20rem);
      min-height: 10rem;
      scroll-snap-align: start;
    }

    .steps-board li {
      width: min(76vw, 19rem);
      min-height: 12.1rem;
      scroll-snap-align: start;
    }
  }
</style>
