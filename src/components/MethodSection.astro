---
interface Props {
  data: {
    kicker: string;
    title: string;
    audiences: { label: string; text: string; signal?: string }[];
    steps: { title: string; text: string; phase?: string }[];
  };
}
const { data } = Astro.props;
---

<section id="parcours" class="method-section section-shell reveal" aria-labelledby="method-title" data-track-view="homepage_method_view" data-track-label="homepage_method">
  <div class="method-heading">
    <div><p class="kicker">{data.kicker}</p><h2 id="method-title">{data.title}</h2></div>
    <a class="method-link" href="/parcours" data-track="cta_home_method_details">Découvrir le parcours<span aria-hidden="true">→</span></a>
  </div>
  <ol class="method-timeline" aria-label="Le parcours Sunelys en trois étapes">
    {data.steps.map((step, index) => (
      <li>
        <span class="timeline-number" aria-hidden="true">0{index + 1}</span>
        <h3>{step.title}</h3>
        <p>{step.text}</p>
      </li>
    ))}
  </ol>
</section>
