---
import BaseLayout from "../layouts/BaseLayout.astro";
import FormPrivacyNote from "../components/FormPrivacyNote.astro";
import LeadFields from "../components/LeadFields.astro";

const successUrl = "https://sunelys.fr/merci?source=contact_form";
const leadFormAction = import.meta.env.PUBLIC_LEAD_FORM_ACTION || "/api/leads";
const bookingUrl = import.meta.env.PUBLIC_BOOKING_URL || "https://calendly.com/contact-sunelys/30min";
const hasBookingUrl = Boolean(bookingUrl);

const supportCards = [
  {
    title: "Email",
    value: "contact@sunelys.fr",
    href: "mailto:contact@sunelys.fr",
    track: "cta_contact_email",
  },
  {
    title: "Téléphone",
    value: "06 95 90 79 19",
    href: "tel:+33695907919",
    track: "cta_contact_phone",
  },
  {
    title: "Localisation",
    value: "Les Adrets-de-l’Estérel · France",
    href: "https://maps.google.com/?q=49%20impasse%20des%20lauriers%2083600%20Les%20Adrets%20de%20l%27Esterel",
    track: "cta_contact_address",
  },
];
---

<BaseLayout
  title="Contact installateurs photovoltaïques | Sunelys"
  description="Demandez un diagnostic administratif Sunelys sous 24 h ouvrées pour vos dossiers photovoltaïques bloqués ou chronophages : DP, Consuel, raccordement, EDF OA, MaPrimeRénov' et CEE."
>
  <section class="contact-intake" aria-labelledby="contact-title" data-track-view="contact_hero_view" data-track-label="contact_diagnostic_hero">
    <header class="intake-heading">
      <p class="eyebrow">Contact Sunelys</p>
      <h1 id="contact-title">Parlons de votre dossier.</h1>
      <p class="intake-summary">DP, Consuel, raccordement : indiquez votre besoin. Nous vous répondons sous 24 h ouvrées.</p>
    </header>

    <div class="intake-form" aria-labelledby="form-title" data-track-view="contact_intake_view" data-track-label="contact_diagnostic_intake">
      <h2 id="form-title">Votre demande</h2>
      <form
        id="contact-form"
        class="form-grid"
        action={leadFormAction}
        method="POST"
        data-lead-form
        data-conversion-type="form_contact"
      >
        <input type="hidden" name="_subject" value="Nouveau diagnostic administratif Sunelys" />
        <input type="hidden" name="_captcha" value="false" />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_next" value={successUrl} />
        <input type="hidden" name="source_page" id="source-page-field" />
        <input type="hidden" name="conversion_type" value="form_contact" />
        <input type="hidden" name="lead_stage" value="contact_form_submitted" />
        <input type="hidden" name="service_interest" id="service-interest-field" />
        <input type="hidden" name="lead_source_detail" id="lead-source-detail-field" />
        <input type="hidden" name="qualification_hint" value="brief contact avec besoin obligatoire et contexte complémentaire optionnel" />
        <input type="hidden" name="lead_status" value="Nouveau lead" />
        <input type="hidden" name="lead_pipeline" value="Site web - Diagnostic administratif" />
        <input type="hidden" name="lead_owner" value="Sunelys commercial" />
        <input type="hidden" name="follow_up_sla" value="24h" />
        <input type="hidden" name="follow_up_sequence" value="email_j0_diagnostic_then_j1_j3_relance" />
        <input type="hidden" name="landing_page" id="landing-page-field" />
        <input type="hidden" name="first_referrer" id="first-referrer-field" />
        <input type="hidden" name="utm_source" id="utm-source-field" />
        <input type="hidden" name="utm_medium" id="utm-medium-field" />
        <input type="hidden" name="utm_campaign" id="utm-campaign-field" />
        <input type="hidden" name="utm_term" id="utm-term-field" />
        <input type="hidden" name="utm_content" id="utm-content-field" />
        <input type="hidden" name="gclid" id="gclid-field" />
        <input type="hidden" name="fbclid" id="fbclid-field" />
        <input type="hidden" name="msclkid" id="msclkid-field" />

        <LeadFields />

        <button id="contact-form-submit" class="btn btn-accent submit-btn" type="submit" data-track="cta_contact_form_submit">
          Faire le point sur mon dossier
          <span aria-hidden="true">→</span>
        </button>
        <FormPrivacyNote />
      </form>
    </div>

    <aside class="intake-info" aria-label="Votre interlocutrice et nos coordonnées">
    <figure class="intake-portrait" data-reveal-item>
      <picture>
        <source srcset="/images/site/founder-variants/myriam-zaoui-founder-variant-b-editorial-2026-07-29.avif" type="image/avif" />
        <img
          src="/images/site/founder-variants/myriam-zaoui-founder-variant-b-editorial-2026-07-29.png"
          alt="Myriam Zaoui, fondatrice de Sunelys"
          width="1054"
          height="1492"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </picture>
      <figcaption><strong>Myriam Zaoui</strong><span>Fondatrice de Sunelys</span></figcaption>
    </figure>
      <div class="intake-details">
        {hasBookingUrl && (
          <a class="intake-booking" href={bookingUrl} target="_blank" rel="noreferrer" data-track="cta_contact_booking_top">
            Réserver un échange <span aria-hidden="true">↗</span>
          </a>
        )}
        {supportCards.map((item) => (
          <a href={item.href} data-track={item.track}
            target={item.href.startsWith("http") ? "_blank" : undefined}
            rel={item.href.startsWith("http") ? "noreferrer" : undefined}>
            <span>{item.title}</span><strong>{item.value}</strong>
          </a>
        ))}
      </div>
    </aside>
  </section>
</BaseLayout>

<script>
  import { resolveLeadIntent } from "../lib/lead-intent.mjs";
  const params = new URLSearchParams(window.location.search);
  const volumeFromQuery = params.get("volume");
  let volumeFromStorage = "";
  try { volumeFromStorage = localStorage.getItem("sunelys_volume_range") || ""; } catch { /* Storage may be disabled. */ }
  const sourceFromQuery = params.get("source") || params.get("service") || "";
  const attribution = window.getSunelysAttribution ? window.getSunelysAttribution() : {};

  const volumeField = document.querySelector("#volume-field");
  const needField = document.querySelector("#need-field");
  const blockedStageField = document.querySelector("#blocked-stage-field");
  const urgencyField = document.querySelector("#urgency-field");
  const sourcePageField = document.querySelector("#source-page-field");
  const serviceInterestField = document.querySelector("#service-interest-field");
  const leadSourceDetailField = document.querySelector("#lead-source-detail-field");
  const contactForm = document.querySelector("#contact-form");

  const fillHidden = (id, value) => {
    const field = document.querySelector(id);
    if (field instanceof HTMLInputElement) field.value = value || "";
  };

  const prefillVolume = volumeFromQuery || volumeFromStorage || "";
  if (volumeField instanceof HTMLSelectElement && prefillVolume) {
    volumeField.value = prefillVolume;
  }

  if (needField instanceof HTMLSelectElement && sourceFromQuery) {
    needField.value = resolveLeadIntent(sourceFromQuery);
  }

  const inferBlockedStageFromSource = (source) => {
    const normalizedSource = source.toLowerCase();
    if (!normalizedSource) return "";
    if (
      normalizedSource.includes("contact_triage_raccordement_consuel") ||
      normalizedSource.includes("bloque") ||
      normalizedSource.includes("blocked") ||
      normalizedSource.includes("reprise") ||
      normalizedSource.includes("urgent")
    ) {
      return "Dossier bloqué / reprise urgente";
    }
    if (normalizedSource.includes("piece") || normalizedSource.includes("pièce") || normalizedSource.includes("complement")) {
      return "Pièce ou complément à sécuriser";
    }
    if (
      normalizedSource.includes("volume") ||
      normalizedSource.includes("flow") ||
      normalizedSource.includes("gestion") ||
      normalizedSource.includes("administrative") ||
      normalizedSource.includes("pilotage")
    ) {
      return "Volume à absorber";
    }
    if (
      normalizedSource.includes("raccordement") ||
      normalizedSource.includes("enedis") ||
      normalizedSource.includes("consuel") ||
      normalizedSource.includes("edf") ||
      normalizedSource.includes("aides") ||
      normalizedSource.includes("maprimerenov") ||
      normalizedSource.includes("cee")
    ) {
      return "Suivi organisme à relancer";
    }
    if (normalizedSource.includes("diagnostic") || normalizedSource.includes("blog-decision-hub")) {
      return "Choix du périmètre à déléguer";
    }
    if (normalizedSource.includes("sticky") || normalizedSource.includes("header")) {
      return "Je ne sais pas encore";
    }
    return "";
  };

  if (blockedStageField instanceof HTMLSelectElement && sourceFromQuery) {
    const inferredBlockedStage = inferBlockedStageFromSource(sourceFromQuery);
    if (inferredBlockedStage) blockedStageField.value = inferredBlockedStage;
  }

  if (sourcePageField instanceof HTMLInputElement) {
    sourcePageField.value = sourceFromQuery || document.referrer || window.location.pathname;
  }

  const resolveServiceInterest = () => {
    if (needField instanceof HTMLSelectElement && needField.value) return needField.value;
    if (sourceFromQuery) return sourceFromQuery;
    return "Diagnostic administratif installateur";
  };

  const syncLeadQualificationFields = () => {
    if (serviceInterestField instanceof HTMLInputElement) {
      serviceInterestField.value = resolveServiceInterest();
    }
    if (leadSourceDetailField instanceof HTMLInputElement) {
      leadSourceDetailField.value = sourceFromQuery || window.location.pathname;
    }
  };

  syncLeadQualificationFields();
  needField?.addEventListener("change", syncLeadQualificationFields);

  fillHidden("#landing-page-field", attribution.landing_page || "");
  fillHidden("#first-referrer-field", attribution.first_referrer || "");
  fillHidden("#utm-source-field", attribution.utm_source || "");
  fillHidden("#utm-medium-field", attribution.utm_medium || "");
  fillHidden("#utm-campaign-field", attribution.utm_campaign || "");
  fillHidden("#utm-term-field", attribution.utm_term || "");
  fillHidden("#utm-content-field", attribution.utm_content || "");
  fillHidden("#gclid-field", attribution.gclid || "");
  fillHidden("#fbclid-field", attribution.fbclid || "");
  fillHidden("#msclkid-field", attribution.msclkid || "");

  let formViewed = false;

  const buildContactPayload = (label) => ({
    category: "lead",
    label,
    source: sourceFromQuery,
    volume: volumeField instanceof HTMLSelectElement ? volumeField.value : "",
    need: needField instanceof HTMLSelectElement ? needField.value : "",
    blocked_stage: blockedStageField instanceof HTMLSelectElement ? blockedStageField.value : "",
    urgency: urgencyField instanceof HTMLSelectElement ? urgencyField.value : "",
  });

  if ("IntersectionObserver" in window && contactForm instanceof HTMLFormElement) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting || formViewed || !window.trackEvent) return;
          formViewed = true;
          window.trackEvent("contact_form_viewed", buildContactPayload("Contact form viewed"));
          observer.disconnect();
        });
      },
      { threshold: 0.35 }
    );
    observer.observe(contactForm);
  }

  contactForm?.addEventListener("submit", () => {
    syncLeadQualificationFields();
    if (window.trackEvent) {
      window.trackEvent("contact_form_submit", {
        ...buildContactPayload("Contact form"),
        conversion_type: "form_contact",
        lead_stage: "contact_form_submitted",
        service_interest: resolveServiceInterest(),
      });
    }
  });
</script>

<style>
  /* Page-specific specificity keeps shared F1 rules outside this intake untouched. */
  :global(body[data-design="f1"][data-page="/contact"]) :global(main) .contact-intake {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    grid-template-areas: "heading form" "info form";
    align-items: start;
    gap: 28px 64px;
    padding: 40px 0 56px;
    background: transparent;
    border: 0;
    box-shadow: none;
    letter-spacing: 0;
  }
  .intake-heading { grid-area: heading; min-width: 0; }
  .eyebrow { margin: 0 0 12px; color: var(--accent); }
  :global(body[data-design="f1"][data-page="/contact"]) :global(main) .contact-intake h1 {
    max-width: 14ch;
    margin: 0;
    font-size: 48px !important;
    line-height: 1.08;
    letter-spacing: 0;
  }
  .intake-summary { max-width: 42ch; margin: 20px 0 0; color: var(--text-muted); }
  .intake-form {
    grid-area: form;
    min-width: 0;
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--surface);
  }
  :global(body[data-design="f1"][data-page="/contact"]) :global(main) .contact-intake h2 {
    margin: 0 0 20px;
    font-size: 22px !important;
    line-height: 1.2;
    letter-spacing: 0;
  }
  .form-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 16px; padding: 0; }
  .submit-btn { width: 100%; min-height: 48px; margin: 0; border: 0; }
  .intake-form :global(.form-privacy-note) { grid-column: 1 / -1; color: var(--text-muted); }
  .intake-info { grid-area: info; min-width: 0; }
  .intake-portrait { display: grid; grid-template-columns: 80px minmax(0, 1fr); gap: 16px; align-items: center; margin: 0; }
  .intake-portrait picture { display: block; height: 100px; overflow: hidden; border-radius: 4px; }
  .intake-portrait img { display: block; width: 80px; height: 100px; object-fit: cover; object-position: center 25%; }
  .intake-portrait figcaption { display: grid; gap: 4px; }
  .intake-portrait figcaption span { color: var(--text-muted); font-size: 14px; }
  .intake-details { display: grid; margin-top: 24px; }
  .intake-details a { display: grid; gap: 4px; padding: 12px 0; border-bottom: 1px solid var(--line); text-decoration: none; overflow-wrap: anywhere; }
  .intake-details a > span { color: var(--text-muted); font-size: 14px; }
  .intake-details strong { font-size: 15px; font-weight: 500; }
  .intake-details .intake-booking { display: flex; justify-content: space-between; gap: 12px; color: var(--accent); }
  .intake-details a:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  @media (max-width: 900px) {
    :global(body[data-design="f1"][data-page="/contact"]) :global(main) .contact-intake { gap: 24px 32px; }
    :global(body[data-design="f1"][data-page="/contact"]) :global(main) .contact-intake h1 { font-size: 40px !important; }
  }
  @media (max-width: 700px) {
    :global(body[data-design="f1"][data-page="/contact"]) :global(main) .contact-intake {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: "heading" "form" "info";
      padding: 24px 0 40px;
      gap: 24px;
    }
    :global(body[data-design="f1"][data-page="/contact"]) :global(main) .contact-intake h1 { max-width: 16ch; font-size: 36px !important; }
    .intake-summary { margin-top: 12px; }
    .intake-form { padding: 20px 16px; }
  }
</style>
