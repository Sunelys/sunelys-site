---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DossierVisual from "../../components/DossierVisual.astro";
import { dossierChecklist } from "../../data/dossierChecklist";
const total = dossierChecklist.reduce((sum, group) => sum + group.items.length, 0);
---
<BaseLayout title="Checklist dossier photovoltaïque installateur | Sunelys" description="Préparez les éléments de vos dossiers photovoltaïques : projet, déclaration préalable, raccordement Enedis et Consuel. Checklist libre, imprimable et sans inscription." breadcrumbs={[{ name: "Accueil", item: "https://sunelys.fr/" }, { name: "Checklist dossier photovoltaïque" }]}>
  <section class="resource-intro" aria-labelledby="resource-title">
    <div><p class="eyebrow">Ressource installateurs · 20 octobre 2026</p><h1 id="resource-title">Préparer un dossier photovoltaïque.</h1><p>Adresse, pièces, échanges et prochaines actions : les éléments à réunir pour transmettre un dossier exploitable à votre équipe administrative.</p><p class="resource-access">Accès libre · sans inscription · aucun document client demandé</p><a href="#checklist" class="btn btn-accent" data-track="cta_checklist_start">Préparer mes éléments <span aria-hidden="true">↓</span></a></div>
    <DossierVisual kind="urbanisme" priority />
  </section>
  <section id="checklist" class="resource-workspace" aria-labelledby="checklist-title" data-track-view="resource_checklist_view">
    <header class="resource-toolbar"><div><h2 id="checklist-title">Les éléments disponibles</h2><p><output data-checklist-count aria-live="polite">0 sur {total}</output> éléments réunis</p></div><div class="resource-actions"><a href="/ressources/checklist-dossier-photovoltaique.csv" download data-track="cta_checklist_csv">Télécharger le tableau CSV</a><button type="button" data-checklist-print>Imprimer</button><button type="button" data-checklist-reset>Réinitialiser</button></div></header>
    <progress data-checklist-progress max={total} value="0" aria-label="Éléments disponibles"></progress>
    <div class="checklist-groups">{dossierChecklist.map(group => <fieldset><legend>{group.label}</legend>{group.items.map(item => <label class="checklist-row"><input type="checkbox" name={item.id} data-checklist-item /><span><strong>{item.title}</strong><span>{item.detail}</span></span></label>)}</fieldset>)}</div>
    <p class="resource-boundary">Repères de préparation à adapter au projet. Cette checklist ne remplace ni les formulaires officiels, ni l’analyse technique ou réglementaire, ni une liste de pièces demandée par l’organisme concerné. Un élément réuni ne vaut pas validation du dossier.</p>
  </section>
  <section class="resource-handoff" aria-labelledby="handoff-title"><div><p class="eyebrow">La suite de votre dossier</p><h2 id="handoff-title">Préparer les pièces, puis choisir qui suit la démarche.</h2><p>Votre installateur confirme les données techniques. Sunelys peut préparer le volet administratif, déposer dans le périmètre convenu et suivre les échanges. Les décisions restent celles des organismes.</p></div><dl><div><dt>DP complète</dt><dd>119 € HT par dossier · pièces, dépôt et suivi mairie</dd></div><div><dt>Enedis + Consuel</dt><dd>89 € HT par dossier · coordination des deux démarches</dd></div><div><dt>DP + Enedis + Consuel</dt><dd>199 € HT par dossier · EDF OA et aides distincts</dd></div></dl><a href="/contact?source=checklist-dossier-photovoltaique#contact-form" class="btn btn-accent" data-track="cta_checklist_contact">Faire le point sur mon dossier <span aria-hidden="true">→</span></a><p class="resource-boundary">Honoraires administratifs Sunelys. Frais éventuels des organismes précisés séparément avant engagement.</p></section>
  <section class="resource-sources" aria-labelledby="sources-title"><h2 id="sources-title">Références et utilisation</h2><ul><li><a href="https://www.service-public.gouv.fr/particuliers/vosdroits/F36798" target="_blank" rel="noopener noreferrer">Service Public : panneaux solaires sur toiture</a></li><li><a href="https://www.enedis.fr/je-raccorde-une-installation-de-production-delectricite" target="_blank" rel="noopener noreferrer">Enedis : raccordement d’une installation de production</a></li><li><a href="https://www.consuel.com/" target="_blank" rel="noopener noreferrer">Consuel : informations et démarches officielles</a></li></ul><p>Préparée par l’équipe Sunelys. Les formulaires et demandes de chaque organisme font référence pour le dossier concerné.</p><p>Vous pouvez transmettre cette checklist à vos équipes ou citer cette page avec un lien vers sa version à jour. <a href="/contact?source=ressource-retour#contact-form">Signaler une précision utile</a>.</p></section>
</BaseLayout>
<script>
  const items = [...document.querySelectorAll<HTMLInputElement>("[data-checklist-item]")];
  const counter = document.querySelector<HTMLOutputElement>("[data-checklist-count]");
  const progress = document.querySelector<HTMLProgressElement>("[data-checklist-progress]");
  const sync = () => { const checked = items.filter(item => item.checked).length; if (counter) counter.value = `${checked} sur ${items.length}`; if (progress) progress.value = checked; };
  items.forEach(item => item.addEventListener("change", sync));
  document.querySelector("[data-checklist-reset]")?.addEventListener("click", () => { items.forEach(item => { item.checked = false; }); sync(); });
  document.querySelector("[data-checklist-print]")?.addEventListener("click", () => window.print());
  sync();
</script>
<style>
.resource-intro,.resource-workspace,.resource-handoff,.resource-sources{padding:48px 32px;border-bottom:1px solid var(--line)}.resource-intro{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);gap:48px;align-items:center}.resource-intro h1{font-size:42px;line-height:1.15;margin:16px 0 24px}.resource-intro p{color:var(--text-muted);max-width:60ch}.resource-intro .btn{margin-top:24px}.resource-access{font-size:14px}.resource-toolbar{display:flex;align-items:start;justify-content:space-between;gap:24px}.resource-toolbar h2,.resource-handoff h2,.resource-sources h2{font-size:28px;line-height:1.3;margin:0 0 12px}.resource-toolbar p{color:var(--text-muted)}.resource-actions{display:flex;flex-wrap:wrap;gap:12px 24px;align-items:center}.resource-actions a,.resource-actions button{min-height:44px;display:inline-flex;align-items:center;color:var(--text);font:500 15px/1.4 var(--font-sans);text-decoration:underline;text-underline-offset:4px;background:none;border:0;padding:0;cursor:pointer}.resource-actions :focus-visible,.checklist-row input:focus-visible{outline:2px solid var(--accent-text);outline-offset:4px}progress{width:100%;height:8px;margin:16px 0 32px;accent-color:var(--accent)}.checklist-groups{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:32px}fieldset{border:0;padding:0;margin:0;min-width:0}legend{font-size:21px;font-weight:600;padding:0 0 16px;color:var(--text)}.checklist-row{display:flex;gap:14px;padding:18px 0;border-top:1px solid var(--line);cursor:pointer;min-height:70px}.checklist-row input{flex:none;width:20px;height:20px;accent-color:var(--accent);margin:4px 0 0}.checklist-row>span{display:grid;gap:8px;min-width:0}.checklist-row strong{font-size:17px;font-weight:600}.checklist-row>span>span{font-size:15px;color:var(--text-muted);line-height:1.6}.resource-boundary{font-size:14px;line-height:1.6;color:var(--text-muted);margin-top:24px;max-width:90ch}.resource-handoff{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:24px 48px}.resource-handoff p{color:var(--text-muted)}.resource-handoff dl{margin:0}.resource-handoff dl>div{padding:16px 0;border-top:1px solid var(--line)}.resource-handoff dt{font-weight:600}.resource-handoff dd{margin:6px 0 0;color:var(--text-muted)}.resource-handoff>.btn{justify-self:start;align-self:start}.resource-handoff>.resource-boundary{margin:0}.resource-sources li{margin:12px 0}.resource-sources a{color:var(--text);text-underline-offset:4px}.resource-sources p{color:var(--text-muted)}@media(max-width:850px){.resource-intro,.resource-handoff{grid-template-columns:1fr;gap:24px}.resource-toolbar{flex-direction:column}.checklist-groups{grid-template-columns:1fr}.resource-intro h1{font-size:34px}.resource-intro,.resource-workspace,.resource-handoff,.resource-sources{padding:32px 24px}.resource-intro :global(.dossier-visual){max-height:240px}}@media print{:global(.site-header),:global(.site-footer),:global(.cookie-banner),:global(.sticky-lead-bar),:global(.exit-modal),.resource-actions,.resource-intro :global(picture),.resource-handoff>.btn{display:none!important}:global(body),:global(main){background:white!important;color:#20272a!important}.resource-intro{display:block;padding:16px 0}.resource-intro h1{font-size:26px}.resource-intro>.btn{display:none}.resource-workspace,.resource-sources{padding:16px 0}.resource-handoff{display:none}.checklist-groups{display:block}fieldset{break-inside:avoid;margin-bottom:20px}.checklist-row{padding:10px 0;min-height:0}.checklist-row strong,.checklist-row>span>span,legend,.resource-boundary,.resource-sources p,.resource-intro p{color:#20272a!important}.resource-intro :global(.dossier-visual){display:none}}
@media print {
  :global(body[data-design="f1"] main) { --text:#20272a!important; --text-muted:#475052!important; --line:#cbd1d2!important; --accent:#775035!important; --accent-text:#775035!important; --surface:#fff!important; --bg:#fff!important; background:#fff!important; color:#20272a!important; }
}
</style>
