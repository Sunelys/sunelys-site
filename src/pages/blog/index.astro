---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogCard from "../../components/blog/BlogCard.astro";
import ResponsiveImage from "../../components/ResponsiveImage.astro";
import { getPublicBlogPosts } from "../../lib/blogPublication";

const posts = getPublicBlogPosts().sort((a, b) => new Date(b.frontmatter.pubDate).getTime() - new Date(a.frontmatter.pubDate).getTime());
const featuredPost = posts[0];
const categories = [...new Set(posts.map((post) => String(post.frontmatter.category)))];
const structuredData = [{
  "@context": "https://schema.org", "@type": "Blog", name: "Blog Sunelys", url: "https://sunelys.fr/blog",
  description: "Guides administratifs photovoltaïques pour les installateurs : déclaration préalable, Consuel, raccordement et organisation.",
  publisher: { "@type": "Organization", name: "Sunelys", url: "https://sunelys.fr" },
}];
---

<BaseLayout title="Blog photovoltaïque administratif | Sunelys" description="Guides pratiques pour installateurs photovoltaïques : déclaration préalable, Consuel, raccordement Enedis et organisation des dossiers." structuredData={structuredData}>
  <section class="journal-intro" aria-labelledby="journal-title">
    <div class="journal-heading">
      <p class="eyebrow">Ressources Sunelys</p>
      <h1 id="journal-title">Les guides administratifs du solaire.</h1>
      <p>Les pièces à préparer, les étapes à suivre et les erreurs à éviter. Pour les professionnels qui veulent faire avancer leurs dossiers photovoltaïques.</p>
      <div class="journal-links">
        <a class="btn btn-accent" href="#guides" data-track="cta_blog_hero_guides">Trouver mon guide <span aria-hidden="true">↓</span></a>
        <a href="/services" data-track="cta_blog_hero_services">Confier un dossier à Sunelys <span aria-hidden="true">→</span></a>
      </div>
      <p class="journal-count">{posts.length} guides · DP, Consuel, Enedis et organisation</p>
    </div>
    {featuredPost && (
      <article class="journal-feature" data-track-view="blog_featured_view" data-track-label={featuredPost.frontmatter.slug}>
        <a class="journal-feature-image" href={`/blog/${featuredPost.frontmatter.slug}`} aria-label={`Lire : ${featuredPost.frontmatter.title}`} data-track="cta_blog_featured_visual">
          <ResponsiveImage src={featuredPost.frontmatter.coverImage} alt={featuredPost.frontmatter.coverAlt || featuredPost.frontmatter.title} width="1280" height="720" loading="eager" fetchpriority="high" sizes="(max-width: 760px) calc(100vw - 48px), 480px" />
        </a>
        <div class="journal-feature-meta"><span>Dernière publication</span><span>{featuredPost.frontmatter.readingTime}</span></div>
        <h2><a href={`/blog/${featuredPost.frontmatter.slug}`} data-track="cta_blog_featured">{featuredPost.frontmatter.title}</a></h2>
      </article>
    )}
  </section>

  <section id="guides" class="journal-library" aria-labelledby="library-title" data-guide-library>
    <header class="journal-library-head">
      <div><p class="eyebrow">Bibliothèque</p><h2 id="library-title">Une réponse pour chaque étape.</h2></div>
      <p data-guide-count role="status" aria-live="polite" aria-atomic="true">{posts.length} guides</p>
    </header>
    <div class="journal-filters" data-guide-controls hidden>
      <label for="guide-search">Rechercher un guide
        <input type="search" id="guide-search" placeholder="Cerfa, pièces, délais…" autocomplete="off" aria-controls="guide-results" />
      </label>
      <label for="guide-category">Sujet
        <select id="guide-category" aria-controls="guide-results">
          <option value="">Tous les sujets</option>
          {categories.map((category) => <option value={category}>{category}</option>)}
        </select>
      </label>
      <button class="journal-reset" type="button" data-guide-reset hidden>Effacer les filtres</button>
    </div>
    <div id="guide-results" class="journal-grid">
      {posts.map((post) => <BlogCard post={post} />)}
    </div>
    <div class="journal-empty" data-guide-empty hidden>
      <h3>Aucun guide ne correspond à cette recherche.</h3>
      <p>Essayez un autre terme ou consultez les prestations Sunelys.</p>
      <a href="/services">Voir les services <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="journal-delegation" aria-labelledby="journal-delegation-title">
    <div><p class="eyebrow">Passer à la suite</p><h2 id="journal-delegation-title">Comprendre la démarche. Ou nous la confier.</h2><p>Vous êtes installateur ? Nous pouvons reprendre un dossier ponctuel ou le suivi de plusieurs chantiers.</p></div>
    <div class="journal-links"><a class="btn btn-accent" href="/contact?source=blog-final#contact-form" data-track="cta_blog_final_contact">Décrire mon dossier <span aria-hidden="true">→</span></a><a href="/tarifs" data-track="cta_blog_final_pricing">Voir les tarifs fixes <span aria-hidden="true">→</span></a></div>
  </section>
</BaseLayout>

<script>
  import { matchesGuide } from "../../lib/guide-filter.mjs";
  const library = document.querySelector<HTMLElement>("[data-guide-library]");
  if (library) {
    const search = library.querySelector<HTMLInputElement>("#guide-search");
    const category = library.querySelector<HTMLSelectElement>("#guide-category");
    const count = library.querySelector<HTMLElement>("[data-guide-count]");
    const reset = library.querySelector<HTMLButtonElement>("[data-guide-reset]");
    const empty = library.querySelector<HTMLElement>("[data-guide-empty]");
    const controls = library.querySelector<HTMLElement>("[data-guide-controls]");
    const cards = Array.from(library.querySelectorAll<HTMLElement>("[data-guide-card]"));
    if (search && category && count && reset && empty && controls) {
      controls.hidden = false;
      const filter = () => {
        let visible = 0;
        cards.forEach((card) => {
          const match = matchesGuide({ title: card.dataset.guideTitle, description: card.dataset.guideDescription, category: card.dataset.guideCategory }, search.value, category.value);
          card.hidden = !match;
          if (match) visible++;
        });
        count.textContent = `${visible} guide${visible > 1 ? "s" : ""}${category.value ? ` · ${category.value}` : ""}`;
        empty.hidden = visible !== 0;
        reset.hidden = !search.value && !category.value;
      };
      search.addEventListener("input", filter);
      category.addEventListener("change", filter);
      reset.addEventListener("click", () => { search.value = ""; category.value = ""; filter(); search.focus(); });
      filter();
    }
  }
</script>

<style>
  .journal-intro, .journal-library, .journal-delegation { padding: 64px 32px; border-bottom: 1px solid var(--line); }
  .journal-intro { display: grid; grid-template-columns: 1.12fr 1fr; gap: 64px; align-items: center; }
  .journal-heading h1 { font-size: 48px; line-height: 1.08; max-width: 19ch; margin: 16px 0 24px; }
  .journal-heading > p:not(.eyebrow), .journal-delegation p:not(.eyebrow) { color: var(--text-muted); max-width: 56ch; }
  .journal-links { display: flex; gap: 20px; align-items: center; flex-wrap: wrap; margin-top: 28px; }
  .journal-links > a:not(.btn) { color: var(--text); font-size: 16px; min-height: 44px; display: inline-flex; align-items: center; gap: 8px; }
  .journal-heading .journal-count { margin-top: 24px; font-size: 14px; }
  .journal-feature { min-width: 0; }
  .journal-feature-image { display: block; aspect-ratio: 16 / 10; overflow: hidden; border-radius: 4px; background: var(--surface); }
  .journal-feature-meta { display: flex; justify-content: space-between; gap: 16px; color: var(--text-muted); font-size: 14px; margin: 18px 0 12px; }
  .journal-feature-meta > span:first-child { color: var(--accent-text); }
  .journal-feature h2 { font-size: 25px; line-height: 1.2; }
  .journal-feature h2 a { text-decoration: none; }
  .journal-feature h2 a:hover { text-decoration: underline; }
  .journal-library-head { display: flex; align-items: end; justify-content: space-between; gap: 24px; margin-bottom: 28px; }
  .journal-library-head h2, .journal-delegation h2 { font-size: 32px; margin-top: 12px; }
  .journal-library-head > p { color: var(--text-muted); font-size: 15px; flex-shrink: 0; }
  .journal-filters { display: grid; grid-template-columns: minmax(0, 1fr) minmax(220px, 320px) 150px; gap: 20px; align-items: end; margin-bottom: 32px; }
  .journal-filters label { display: grid; gap: 8px; font-size: 15px; color: var(--text-muted); }
  .journal-filters :is(input, select) { width: 100%; min-width: 0; height: 48px; padding: 10px 12px; border: 1px solid #7c8587; border-radius: 4px; background: var(--surface); color: var(--text); font-size: 16px; }
  .journal-filters input::placeholder { color: var(--text-muted); }
  .journal-reset { min-height: 48px; padding: 8px; border: 0; background: transparent; color: var(--text); text-decoration: underline; font-size: 15px; cursor: pointer; }
  .journal-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; }
  .journal-empty { padding: 32px 0; }
  .journal-empty p { color: var(--text-muted); margin-block: 12px; }
  .journal-empty a { color: var(--text); }
  .journal-delegation { display: grid; grid-template-columns: 1fr auto; gap: 40px; align-items: center; }
  .journal-delegation .journal-links { flex-direction: column; align-items: start; margin: 0; }
  .journal-delegation p:not(.eyebrow) { margin-top: 16px; }
  [hidden] { display: none !important; }
  @media (max-width: 1000px) { .journal-intro { gap: 32px; } .journal-heading h1 { font-size: 40px; } .journal-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 760px) {
    .journal-intro, .journal-library, .journal-delegation { padding: 40px 24px; }
    .journal-intro, .journal-delegation { grid-template-columns: 1fr; gap: 32px; }
    .journal-heading h1 { font-size: 34px; max-width: 20ch; }
    .journal-feature-image { aspect-ratio: 16 / 9; }
    .journal-feature h2 { font-size: 23px; }
    .journal-library-head { display: block; } .journal-library-head > p { margin-top: 16px; }
    .journal-library-head h2, .journal-delegation h2 { font-size: 28px; }
    .journal-filters { grid-template-columns: 1fr; gap: 16px; }
    .journal-reset { justify-self: start; }
    .journal-grid { grid-template-columns: 1fr; gap: 0; }
  }
</style>
