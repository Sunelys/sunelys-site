---
import BaseLayout from "../layouts/BaseLayout.astro";
import BlockedDiagnostic from "../components/BlockedDiagnostic.astro";
import DossierVisual from "../components/DossierVisual.astro";
import { isVisibleHref, publicBlogSlugs } from "../lib/blogPublication";

const services = [
  {
    title: "Déclaration préalable panneaux solaires",
    shortTitle: "Déclaration préalable",
    benefit: "Des dossiers mieux cadrés pour limiter les refus et sécuriser le lancement chantier.",
    description:
      "Sunelys constitue, vérifie et suit la déclaration préalable jusqu'au retour administratif afin de réduire les compléments et les délais cachés.",
    points: ["Montage du dossier", "Contrôle documentaire", "Dépôt et suivi mairie"],
    price: "119 €",
    priceNote: "HT / dossier",
    decisionCue: "Quand le dossier doit partir propre en mairie ou être repris après complément.",
    href: "/declaration-prealable-panneaux-solaires",
    guideHref: "/blog/declaration-prealable-panneaux-solaires-erreurs",
    guideLabel: "Lire les erreurs à éviter",
  },
  {
    title: "Sous-traitance DP solaire",
    shortTitle: "Sous-traitance DP",
    benefit: "Un relais dédié pour absorber vos déclarations préalables sans mobiliser vos équipes.",
    description:
      "Nous cadrons, contrôlons et suivons vos DP solaires dans une logique de flux régulier, avec une visibilité claire sur les statuts.",
    points: ["Traitement récurrent", "Contrôle avant dépôt", "Organisation adaptée au flux"],
    price: "Sur cadrage",
    priceNote: "selon volume DP",
    decisionCue: "Quand le volume DP devient récurrent et pèse sur vos équipes internes.",
    href: "/sous-traitance-declaration-prealable-solaire",
    guideHref: "/blog/sous-traiter-declaration-prealable-photovoltaique",
    guideLabel: "Sous-traiter ses DP",
  },
  {
    title: "Dossier Consuel photovoltaïque",
    shortTitle: "Consuel",
    benefit: "Une conformité mieux anticipée pour accélérer la mise en service.",
    description:
      "Nous préparons les pièces, suivons les échanges et pilotons le dossier Consuel jusqu'à validation.",
    points: ["Préparation des pièces", "Gestion des compléments", "Suivi jusqu'à validation"],
    price: "Inclus",
    priceNote: "dans le pack 89 € raccordement + Consuel",
    decisionCue: "Quand la mise en service risque de décrocher faute de suivi clair.",
    href: "/dossier-consuel-photovoltaique",
    guideHref: "/blog/consuel-photovoltaique-delais-dossier",
    guideLabel: "Lire le guide Consuel",
  },
  {
    title: "Raccordement Enedis + Consuel photovoltaïque",
    shortTitle: "Raccordement + Consuel",
    benefit: "Un parcours réseau et conformité suivi dans le même mouvement.",
    description:
      "Sunelys coordonne le raccordement Enedis, les pièces techniques et le Consuel pour réduire les angles morts avant mise en service.",
    points: ["Constitution du dossier", "Suivi Enedis et Consuel", "Traçabilité des jalons"],
    price: "89 €",
    priceNote: "HT / pack",
    decisionCue: "Quand Enedis, les pièces ou le Consuel doivent avancer ensemble.",
    href: "/raccordement-enedis-photovoltaique",
    guideHref: "/blog/etapes-raccordement-enedis-panneaux-solaires",
    guideLabel: "Étapes raccordement",
  },
  {
    title: "EDF OA - compte et contrat d'achat",
    shortTitle: "EDF OA",
    benefit: "Un parcours contractuel cadré jusqu'à la signature électronique du client final.",
    description:
      "Sunelys accompagne l'activation de l'espace producteur, suit le dossier et sécurise les demandes de complément.",
    points: ["Activation du compte", "Suivi du dossier", "Invitation de signature"],
    price: "49 €",
    priceNote: "HT / dossier",
    decisionCue: "Quand l'espace producteur ou la signature du contrat d'achat reste en attente.",
    href: "/edf-oa",
    guideHref: "",
    guideLabel: "",
    ctaLabel: "Voir l'offre EDF OA",
  },
  {
    title: "MaPrimeRénov' - montage & suivi",
    shortTitle: "MaPrimeRénov'",
    benefit: "Des dossiers d'aide structurés pour limiter les refus et sécuriser le versement.",
    description:
      "Sunelys vérifie l'éligibilité, monte le dossier, prépare le dépôt ANAH et suit les échanges jusqu'à la décision.",
    points: ["Contrôle d'éligibilité", "Montage et dépôt", "Suivi jusqu'au versement"],
    decisionCue: "Quand le dossier ANAH doit être monté et suivi sans relances dispersées.",
    href: "/contact?source=maprimerenov#contact-form",
    guideHref: "",
    guideLabel: "",
    ctaLabel: "Cadrer MaPrimeRénov'",
    price: "129 €",
  },
  {
    title: "CEE - certificats d'économies d'énergie",
    shortTitle: "CEE",
    benefit: "Un contrôle administratif pour éviter les dossiers rejetés ou incomplets.",
    description:
      "Nous contrôlons les devis et factures, montons le dossier CEE et suivons la validation avec les éléments attendus.",
    points: ["Contrôle documentaire", "Montage du dossier", "Suivi jusqu'à validation"],
    decisionCue: "Quand devis, factures et pièces doivent être contrôlés avant validation.",
    href: "/contact?source=cee#contact-form",
    guideHref: "",
    guideLabel: "",
    ctaLabel: "Cadrer les CEE",
    price: "99 €",
  },
  {
    title: "Pack MaPrimeRénov' + CEE",
    shortTitle: "Pack aides",
    benefit: "Les deux aides pilotées ensemble sur un même chantier.",
    description:
      "Sunelys coordonne les deux montages pour éviter les doublons, les oublis et les allers-retours dispersés.",
    points: ["Deux dossiers coordonnés", "Suivi des validations", "Pièces manquantes visibles"],
    decisionCue: "Quand MaPrimeRénov' et CEE doivent être pilotés ensemble sur le même chantier.",
    href: "/contact?source=pack-maprimerenov-cee#contact-form",
    guideHref: "",
    guideLabel: "",
    ctaLabel: "Cadrer le pack aides",
    price: "199 €",
  },
  {
    title: "Gestion administrative photovoltaïque",
    shortTitle: "Pilotage multi-dossiers",
    benefit: "Un pilotage global pour alléger vos équipes et industrialiser vos flux.",
    description:
      "Quand les volumes montent, Sunelys structure l'ensemble du parcours administratif pour préserver la qualité d'exécution.",
    points: ["Prise en charge multi-dossiers", "Méthode standardisée", "Coordination continue"],
    price: "199 €",
    priceNote: "HT / dossier",
    decisionCue: "Quand DP, raccordement et Consuel doivent sortir de votre équipe dans un même flux.",
    href: "/gestion-administrative-photovoltaique",
    guideHref: "/blog/externaliser-administratif-photovoltaique",
    guideLabel: "Externaliser l'admin PV",
  },
];

const mainServices = [services[0], services[3], services[8]];
const additionalServices = [services[4], services[5], services[6], services[7]];
const structuredData = {
  "@context": "https://schema.org", "@type": "OfferCatalog", name: "Services administratifs Sunelys",
  itemListElement: services.map((service) => ({ "@type": "Offer", itemOffered: { "@type": "Service", name: service.title, description: service.description, url: new URL(service.href, "https://sunelys.fr").toString() } })),
};
---

<BaseLayout title="Services administratifs photovoltaïques | Sunelys" description="DP, Consuel, raccordement, EDF OA, MaPrimeRénov' et CEE : services administratifs délégables pour installateurs et structures ENR." structuredData={[structuredData]}>
  <section class="catalogue-intro" aria-labelledby="services-title">
    <div>
      <p class="eyebrow">Services Sunelys</p>
      <h1 id="services-title">Vos démarches photovoltaïques, prises en charge.</h1>
      <p>Vous gardez le chantier et la relation client. Nous préparons les dossiers, suivons les échanges et vous signalons les pièces ou décisions attendues.</p>
      <div class="catalogue-actions"><a class="btn btn-accent" href="#prestations" data-track="cta_services_catalogue">Choisir ma prestation <span aria-hidden="true">↓</span></a><a href="/contact?source=services-hero#contact-form" data-track="cta_services_hero_primary">Décrire mon besoin <span aria-hidden="true">→</span></a></div>
    </div>
    <DossierVisual kind="urbanisme" priority />
  </section>
    <aside class="catalogue-reperes" aria-label="Le cadre de prise en charge">
      <dl><div><dt>Engagement</dt><dd>Sans abonnement ni volume minimum</dd></div><div><dt>Tarification</dt><dd>Un forfait par dossier</dd></div><div><dt>Échanges</dt><dd>Une équipe joignable et un portail de suivi</dd></div></dl>
      <a href="/parcours" data-track="cta_services_parcours">Comment se passe la reprise ? <span aria-hidden="true">→</span></a>
    </aside>

  <nav class="catalogue-nav" aria-label="Accès direct aux prestations"><a href="#prestations">Photovoltaïque</a><a href="#volume">Dossiers récurrents</a><a href="#complementary-services-title">EDF OA et aides</a></nav>

  <section id="prestations" class="catalogue-section" aria-labelledby="prestations-title">
    <header><p class="eyebrow">Photovoltaïque</p><h2 id="prestations-title">Une étape précise ou le parcours complet.</h2><p>Choisissez ce que vous souhaitez déléguer. Les détails de chaque prestation restent accessibles avant toute demande.</p></header>
    <div class="catalogue-rows">
      {mainServices.map((service, index) => (
        <article class="catalogue-row" aria-labelledby={`catalogue-service-${index}`}>
          <div class="catalogue-service"><span class="catalogue-index">0{index + 1}</span><div><h3 id={`catalogue-service-${index}`}>{index === 2 ? "DP + Enedis + Consuel" : service.shortTitle}</h3><p>{service.decisionCue}</p></div></div>
          <ul>{service.points.map((point) => <li>{point}</li>)}</ul>
          <div class="catalogue-price"><strong>{service.price}</strong><span>{service.priceNote ?? "HT / dossier"}</span><a href={service.href} data-track="cta_services_detail" data-track-label={service.shortTitle}>Voir la prestation <span aria-hidden="true">→</span></a></div>
          <details class="catalogue-details"><summary>Ce que Sunelys prend en charge</summary><p>{service.description}</p>{service.guideHref && isVisibleHref(service.guideHref, publicBlogSlugs) && <a href={service.guideHref} data-track="cta_services_guide">{service.guideLabel}</a>}{index === 1 && <p><a href="/dossier-consuel-photovoltaique">Consulter le détail du dossier Consuel</a></p>}</details>
        </article>
      ))}
    </div>
    <p class="catalogue-note">Le périmètre de prise en charge est précisé avant de commencer. Les décisions des organismes restent indépendantes de Sunelys. <a href="/tarifs#tarifs-photovoltaique">Voir les conditions tarifaires</a>.</p>
  </section>

  <section id="volume" class="catalogue-volume" aria-labelledby="volume-title">
    <div><p class="eyebrow">Votre organisation</p><h2 id="volume-title">Plusieurs dossiers à nous confier ?</h2><p>Une série de DP, un pic de charge ou des dossiers chaque mois : le fonctionnement se prépare avec votre référent, selon les démarches réellement déléguées.</p></div>
    <div class="catalogue-volume-links"><a href="/sous-traitance-declaration-prealable-solaire" data-track="cta_services_flow_detail"><strong>Sous-traiter les déclarations préalables</strong><span>Organisation selon votre volume DP <b aria-hidden="true">→</b></span></a><a href="/sous-traitance-administrative-photovoltaique-installateur" data-track="cta_services_specialist_seo"><strong>Déléguer l'administratif de vos installations</strong><span>DP, réseau, conformité et suivi <b aria-hidden="true">→</b></span></a></div>
  </section>

  <section class="catalogue-section" aria-labelledby="complementary-services-title">
    <header><p class="eyebrow">Prestations complémentaires</p><h2 id="complementary-services-title">EDF OA et aides à la rénovation.</h2><p>Des démarches distinctes, à choisir selon le contrat ou le projet concerné.</p></header>
    <div class="catalogue-complements">
      {additionalServices.map((service) => (
        <article><div><h3>{service.shortTitle}</h3><p>{service.description}</p></div><div class="catalogue-price"><strong>{service.price}</strong><span>HT / dossier</span></div><a href={service.href} data-track="cta_services_aid_detail" data-track-label={service.shortTitle}>{service.ctaLabel || "Voir la prestation"} <span aria-hidden="true">→</span></a></article>
      ))}
    </div>
    <a class="catalogue-link" href="/tarifs#aides-renovation" data-track="cta_services_aides_tarifs">Comparer les forfaits et ce qui est inclus <span aria-hidden="true">→</span></a>
  </section>

  <BlockedDiagnostic source="services_diagnostic_dossiers_bloques" title="Quelle démarche souhaitez-vous nous confier ?" text="Le besoin, votre nom et votre email suffisent. Nous vous répondons sous 24h ouvrées pour préciser la suite." submitLabel="Recevoir mon cadrage sous 24h" />
</BaseLayout>

<style>
  .catalogue-intro a:not(.btn), .catalogue-nav a, .catalogue-section a, .catalogue-volume a { color: var(--text); text-decoration-color: var(--accent-text); }
  .catalogue-intro, .catalogue-section, .catalogue-volume { padding: 64px 32px; border-bottom: 1px solid var(--line); }
  .catalogue-intro { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 48px; align-items: start; }
  .catalogue-intro h1 { font-size: 48px; line-height: 1.1; max-width: 22ch; margin: 16px 0 24px; }
  .catalogue-intro p:not(.eyebrow), .catalogue-volume p:not(.eyebrow), .catalogue-section header > p:not(.eyebrow) { max-width: 65ch; color: var(--text-muted); }
  .catalogue-actions { display: flex; gap: 24px; align-items: center; flex-wrap: wrap; margin-top: 28px; }
  .catalogue-actions > a:not(.btn), .catalogue-reperes > a, .catalogue-link { display: inline-flex; align-items: center; min-height: 44px; gap: 8px; font-size: 16px; }
  .catalogue-reperes { padding: 20px 32px; border-bottom: 1px solid var(--line); }
  .catalogue-reperes dl { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; margin: 0; }
  .catalogue-reperes dl > div { padding-block: 8px; }
  .catalogue-reperes > a { color: var(--text); margin-top: 8px; }
  .catalogue-reperes dt { color: var(--text-muted); font-size: 14px; margin-bottom: 4px; }
  .catalogue-reperes dd { margin: 0; font-size: 18px; }
  .catalogue-nav { display: flex; flex-wrap: wrap; gap: 8px 32px; padding: 16px 32px; border-bottom: 1px solid var(--line); }
  .catalogue-nav a { display: inline-flex; min-height: 44px; align-items: center; font-size: 16px; }
  .catalogue-section header { margin-bottom: 32px; }
  .catalogue-section h2, .catalogue-volume h2 { font-size: 32px; margin-block: 12px 16px; }
  .catalogue-row { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr) 200px; gap: 20px 40px; padding: 32px 0; border-top: 1px solid var(--line); }
  .catalogue-service { display: flex; gap: 20px; min-width: 0; }
  .catalogue-index { padding-top: 5px; font-size: 14px; color: var(--accent-text); }
  .catalogue-row h3, .catalogue-complements h3 { font-size: 25px; margin-bottom: 12px; }
  .catalogue-row p, .catalogue-complements p { color: var(--text-muted); font-size: 16px; }
  .catalogue-row ul { padding-left: 20px; margin: 0; font-size: 16px; color: var(--text-muted); }
  .catalogue-row li + li { margin-top: 8px; }
  .catalogue-price { display: flex; flex-direction: column; align-items: start; }
  .catalogue-price > strong { color: var(--text); font-size: 32px; line-height: 1.1; white-space: nowrap; }
  .catalogue-price > span { color: var(--text-muted); font-size: 14px; margin-top: 6px; }
  .catalogue-price a { display: inline-flex; min-height: 44px; align-items: center; gap: 8px; margin-top: 12px; font-size: 16px; }
  .catalogue-details { grid-column: 1 / -1; font-size: 16px; }
  .catalogue-details summary { min-height: 44px; padding: 10px 0; cursor: pointer; color: var(--text); }
  .catalogue-details p { max-width: 80ch; margin: 8px 0; }
  .catalogue-note { font-size: 14px; color: var(--text-muted); border-top: 1px solid var(--line); padding-top: 20px; }
  .catalogue-volume { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; }
  .catalogue-volume-links a { display: block; padding: 20px 0; border-bottom: 1px solid var(--line); text-decoration: none; }
  .catalogue-volume-links a:hover strong { text-decoration: underline; }
  .catalogue-volume-links span { display: flex; justify-content: space-between; gap: 12px; font-size: 16px; color: var(--text-muted); margin-top: 8px; }
  .catalogue-volume-links b { color: var(--accent-text); }
  .catalogue-complements article { display: grid; grid-template-columns: minmax(0, 1fr) 140px 230px; align-items: center; gap: 32px; padding: 28px 0; border-top: 1px solid var(--line); }
  .catalogue-complements a { font-size: 16px; min-height: 44px; display: inline-flex; align-items: center; gap: 8px; }
  .catalogue-link { margin-top: 24px; }
  @media (max-width: 1000px) { .catalogue-intro { gap: 32px; } .catalogue-intro h1 { font-size: 40px; } .catalogue-row { gap: 20px; grid-template-columns: 1fr 1fr; } .catalogue-row ul { grid-column: 1; } .catalogue-price { grid-column: 2; grid-row: 1 / 3; justify-self: end; } .catalogue-complements article { grid-template-columns: 1fr 160px; } .catalogue-complements a { grid-column: 1 / -1; } }
  @media (max-width: 700px) {
    .catalogue-intro, .catalogue-section, .catalogue-volume { padding: 40px 24px; }
    .catalogue-intro, .catalogue-volume { grid-template-columns: 1fr; gap: 32px; }
    .catalogue-intro h1 { font-size: 34px; }
    .catalogue-reperes { padding: 16px 24px; }
    .catalogue-reperes dl { grid-template-columns: 1fr; gap: 0; }
    .catalogue-reperes dl > div { display: grid; grid-template-columns: 90px 1fr; gap: 16px; padding-block: 12px; }
    .catalogue-reperes dd { font-size: 16px; }
    .catalogue-nav { gap: 4px 24px; padding: 12px 24px; }
    .catalogue-section h2, .catalogue-volume h2 { font-size: 28px; }
    .catalogue-row { grid-template-columns: 1fr; gap: 16px; }
    .catalogue-row h3 { font-size: 24px; }
    .catalogue-row ul { margin-left: 38px; }
    .catalogue-price { grid-column: auto; grid-row: auto; justify-self: start; }
    .catalogue-row > .catalogue-price { margin-left: 38px; }
    .catalogue-details { padding-left: 38px; }
    .catalogue-complements article { grid-template-columns: minmax(0, 1fr) 92px; gap: 16px; }
    .catalogue-complements .catalogue-price { grid-column: 2; grid-row: 1; justify-self: end; }
    .catalogue-complements h3 { font-size: 23px; }
    .catalogue-complements .catalogue-price > strong { font-size: 28px; }
    .catalogue-complements article > a { grid-column: 1 / -1; }
  }
</style>
